{
    "title": "Chart Values",
    "type": "object",
    "properties": {
        "global": {
            "type": "object",
            "properties": {
                "imageRegistry": {
                    "type": "string",
                    "description": "Global image registry",
                    "default": ""
                },
                "imagePullSecrets": {
                    "type": "array",
                    "description": "Global registry secret names as an array",
                    "default": [],
                    "items": {}
                },
                "enterprise": {
                    "type": "boolean",
                    "description": "Enable enterprise mode, adding additional features and configurations",
                    "default": false
                },
                "appHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent application services",
                    "default": "apps.telicent.io"
                },
                "authHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent authentication services, including OIDC providers",
                    "default": "auth.telicent.io"
                },
                "groupsClaim": {
                    "type": "string",
                    "description": "Key used to retrieve groups from the OIDC provider",
                    "default": "groups"
                },
                "jwksUrl": {
                    "type": "string",
                    "description": "Endpoint exposing multiple public keys represented as JWKs (JSON Web Key Set)",
                    "default": "https://{yourAuthdomain}/.well-known/jwks.json"
                },
                "istioNamespace": {
                    "type": "string",
                    "description": "Namespace in which Istio is deployed",
                    "default": "istio-system"
                },
                "istioServiceAccountName": {
                    "type": "string",
                    "description": "Name of the Istio service account",
                    "default": "istio-ingress"
                },
                "istioGatewayName": {
                    "type": "string",
                    "description": "Name of the Istio Gateway Resource (LB operating at the edge of the mesh)",
                    "default": "ingress-gateway"
                },
                "kafkaBootstrapUrls": {
                    "type": "string",
                    "description": "Comma separated list containing Kafka bootstrap URLs",
                    "default": "kafka-bootstrap.kafka.svc.cluster.local:9092"
                },
                "existingConfigSecretName": {
                    "type": "string",
                    "description": "Name of an existing secret containing Kafka configuration",
                    "default": ""
                },
                "kafkaConfigUsername": {
                    "type": "string",
                    "description": "Username for Kafka authentication",
                    "default": "your.kafka.username.here"
                },
                "kafkaConfigPassword": {
                    "type": "string",
                    "description": "Password for Kafka authentication",
                    "default": "your.kafka.password.here"
                },
                "kafkaConfigProtocol": {
                    "type": "string",
                    "description": "Protocol used for Kafka communication",
                    "default": "SASL_SSL"
                },
                "kafkaConfigMechanism": {
                    "type": "string",
                    "description": "SASL mechanism used for Kafka authentication",
                    "default": "SCRAM-SHA-512"
                },
                "existingTruststoreSecretName": {
                    "type": "string",
                    "description": "Name of an existing secret containing the truststore",
                    "default": ""
                },
                "truststore": {
                    "type": "object",
                    "properties": {
                        "mountPath": {
                            "type": "string",
                            "description": "The mount path for the truststore in the container",
                            "default": "/app/config/truststore"
                        }
                    }
                }
            }
        },
        "enabled": {
            "type": "boolean",
            "description": "Enable paperback-writer deployment",
            "default": false
        },
        "replicaCount": {
            "type": "number",
            "description": "Number of paperback-writer replicas to deploy",
            "default": 1
        },
        "image": {
            "type": "object",
            "properties": {
                "repository": {
                    "type": "string",
                    "description": "paperback-writer image repository",
                    "default": "telicent/telicent-paperback-writer"
                },
                "pullPolicy": {
                    "type": "string",
                    "description": "paperback-writer image pull policy",
                    "default": "IfNotPresent"
                },
                "tag": {
                    "type": "string",
                    "description": "paperback-writer image tag. If not set, defaults to chart appVersion",
                    "default": ""
                }
            }
        },
        "imagePullSecrets": {
            "type": "array",
            "description": "Specify registry secret names as an array",
            "default": [],
            "items": {}
        },
        "nameOverride": {
            "type": "string",
            "description": "String to replace the name of the chart in the Chart.yaml file",
            "default": ""
        },
        "fullnameOverride": {
            "type": "string",
            "description": "String to fully override the generated release name",
            "default": ""
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "create": {
                    "type": "boolean",
                    "description": "Specifies whether a service account should be created",
                    "default": true
                },
                "automount": {
                    "type": "boolean",
                    "description": "Automatically mount a ServiceAccount's API credentials",
                    "default": true
                },
                "annotations": {
                    "type": "object",
                    "description": "Additional custom annotations for the ServiceAccount",
                    "default": {}
                },
                "name": {
                    "type": "string",
                    "description": "Name of the ServiceAccount to use. If not set and create is true, a name is generated using the fullname template",
                    "default": ""
                }
            }
        },
        "podAnnotations": {
            "type": "object",
            "description": "Additional annotations for the pod",
            "default": {}
        },
        "podLabels": {
            "type": "object",
            "description": "Additional labels for the pod",
            "default": {}
        },
        "podSecurityContext": {
            "type": "object",
            "description": "security context for the pod",
            "default": {}
        },
        "securityContext": {
            "type": "object",
            "description": "security context for the container",
            "default": {}
        },
        "service": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "description": "paperback-writer service type",
                    "default": "ClusterIP"
                },
                "port": {
                    "type": "number",
                    "description": "paperback-writer service port",
                    "default": 8000
                }
            }
        },
        "resources": {
            "type": "object",
            "description": "Resource requests and limits for the container",
            "default": {}
        },
        "livenessProbe": {
            "type": "object",
            "properties": {
                "httpGet": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "type": "string",
                            "description": "Path for liveness probe",
                            "default": "/availability"
                        },
                        "port": {
                            "type": "string",
                            "description": "Port for liveness probe",
                            "default": "http"
                        }
                    }
                }
            }
        },
        "readinessProbe": {
            "type": "object",
            "properties": {
                "httpGet": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "type": "string",
                            "description": "Path for readiness probe",
                            "default": "/availability"
                        },
                        "port": {
                            "type": "string",
                            "description": "Port for readiness probe",
                            "default": "http"
                        }
                    }
                }
            }
        },
        "volumes": {
            "type": "array",
            "description": "Additional volumes on the output Deployment definition",
            "default": [],
            "items": {}
        },
        "volumeMounts": {
            "type": "array",
            "description": "Additional volumeMounts on the output Deployment definition",
            "default": [],
            "items": {}
        },
        "nodeSelector": {
            "type": "object",
            "description": "Node labels for pod assignment",
            "default": {}
        },
        "tolerations": {
            "type": "array",
            "description": "Tolerations for pod assignment",
            "default": [],
            "items": {}
        },
        "affinity": {
            "type": "object",
            "description": "Affinity for pod assignment",
            "default": {}
        },
        "configuration": {
            "type": "object",
            "properties": {
                "sparqlUrl": {
                    "type": "string",
                    "description": "SPARQL endpoint URL. Defaults to http://release-name-graph.release-namespace.svc.cluster.local:3030",
                    "default": ""
                },
                "sparqlUser": {
                    "type": "string",
                    "description": "SPARQL endpoint username. Use existing secret to set these values if possible (.Values.existingSecretName)",
                    "default": ""
                },
                "sparqlPwd": {
                    "type": "string",
                    "description": "SPARQL endpoint password. Use existing secret to set these values if possible (.Values.existingSecretName)",
                    "default": ""
                },
                "sparqlDefaultLabel": {
                    "type": "string",
                    "description": "Default label for SPARQL queries",
                    "default": "!"
                },
                "jwksDisabled": {
                    "type": "string",
                    "description": "Disable JWKS validation",
                    "default": "false"
                },
                "jwtHeader": {
                    "type": "string",
                    "description": "JWT header name",
                    "default": "Authorization"
                },
                "accessApiUrl": {
                    "type": "string",
                    "description": "URL for the Access API. Defaults to http://release-name-access-api.release-namespace.svc.cluster.local:8080",
                    "default": ""
                },
                "cacertPath": {
                    "type": "string",
                    "description": "Path to CA certs in the container",
                    "default": ""
                },
                "authServerBaseUrl": {
                    "type": "string",
                    "description": "Base url of the Auth server. Defaults to <release-name>-auth.<release-namespace>.svc.cluster.local:9000",
                    "default": ""
                }
            }
        },
        "existingConfigMapName": {
            "type": "string",
            "description": "Name of an existing ConfigMap to use for configuration",
            "default": ""
        },
        "existingSecretName": {
            "type": "string",
            "description": "Name of an existing Secret to use for credentials",
            "default": ""
        },
        "existingCacertConfigmapName": {
            "type": "string",
            "description": "Name of an existing ConfigMap to use for CA certs. If not set, and cacert is provided, a ConfigMap will be created",
            "default": ""
        },
        "cacert": {
            "type": "string",
            "description": "CA certificate data in PEM format",
            "default": ""
        },
        "istio": {
            "type": "object",
            "properties": {
                "ingress": {
                    "type": "object",
                    "properties": {
                        "principal": {
                            "type": "string",
                            "description": "Principal used for ingress traffic by the Istio AuthorizationPolicy. If not set, a principal is generated using 'global.istioNamespace' and 'global.istioServiceAccountName'",
                            "default": ""
                        }
                    }
                }
            }
        }
    }
}
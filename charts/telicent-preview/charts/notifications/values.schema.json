{
    "title": "Chart Values",
    "type": "object",
    "properties": {
        "global": {
            "type": "object",
            "properties": {
                "imageRegistry": {
                    "type": "string",
                    "description": "Global image registry",
                    "default": ""
                },
                "imagePullSecrets": {
                    "type": "array",
                    "description": "Global registry secret names as an array",
                    "default": [],
                    "items": {}
                },
                "enterprise": {
                    "type": "boolean",
                    "description": "Enable enterprise mode, adding additional features and configurations",
                    "default": false
                },
                "appHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent application services. This value cannot be changed after it is set",
                    "default": ""
                },
                "apiHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent Api services. This value cannot be changed after it is set",
                    "default": ""
                },
                "authHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent authentication services, including OIDC providers. This value cannot be changed after it is set",
                    "default": ""
                },
                "truststore": {
                    "type": "object",
                    "properties": {
                        "existingSecret": {
                            "type": "string",
                            "description": "Name of an existing secret containing the truststore",
                            "default": ""
                        },
                        "mountPath": {
                            "type": "string",
                            "description": "The mount path for the truststore in the container",
                            "default": "/app/config/truststore"
                        }
                    }
                },
                "groupsClaim": {
                    "type": "string",
                    "description": "Key used to retrieve groups from the OIDC provider",
                    "default": "groups"
                },
                "jwksUrl": {
                    "type": "string",
                    "description": "Endpoint exposing multiple public keys represented as JWKs (JSON Web Key Set)",
                    "default": "https://{yourAuthdomain}/.well-known/jwks.json"
                },
                "istioNamespace": {
                    "type": "string",
                    "description": "Namespace in which Istio is deployed",
                    "default": "istio-system"
                },
                "istioServiceAccountName": {
                    "type": "string",
                    "description": "Name of the Istio service account",
                    "default": "istio-ingress"
                },
                "istioGatewayName": {
                    "type": "string",
                    "description": "Name of the Istio Gateway Resource (LB operating at the edge of the mesh)",
                    "default": "ingress-gateway"
                },
                "istioVirtualServiceEnabled": {
                    "type": "boolean",
                    "description": "Enable Istio traffic routing to a named destination service",
                    "default": true
                },
                "kafka": {
                    "type": "object",
                    "properties": {
                        "bootstrapServers": {
                            "type": "string",
                            "description": "Comma separated list containing Kafka bootstrap servers",
                            "default": "kafka-bootstrap.kafka.svc.cluster.local:9092"
                        },
                        "existingConfigSecretName": {
                            "type": "string",
                            "description": "Name of an existing secret containing Kafka configuration (preferred over individual settings below for security)",
                            "default": ""
                        },
                        "username": {
                            "type": "string",
                            "description": "Username for Kafka authentication",
                            "default": "your.kafka.username.here"
                        },
                        "password": {
                            "type": "string",
                            "description": "Password for Kafka authentication",
                            "default": "your.kafka.password.here"
                        },
                        "protocol": {
                            "type": "string",
                            "description": "Protocol used for Kafka communication",
                            "default": "SASL_SSL"
                        },
                        "mechanism": {
                            "type": "string",
                            "description": "SASL mechanism used for Kafka authentication",
                            "default": "SCRAM-SHA-512"
                        }
                    }
                }
            }
        },
        "kafka": {
            "type": "object",
            "properties": {
                "topic": {
                    "type": "string",
                    "description": "Topic to consume messages from",
                    "default": "notifications"
                },
                "dlqTopic": {
                    "type": "string",
                    "description": "Dead-letter topic for failed messages",
                    "default": "notifications.dlq"
                }
            }
        },
        "postgres": {
            "type": "object",
            "properties": {
                "host": {
                    "type": "string",
                    "description": "PostgreSQL connection hostname",
                    "default": "postgres"
                },
                "port": {
                    "type": "number",
                    "description": "PostgreSQL connection port",
                    "default": 5432
                },
                "name": {
                    "type": "string",
                    "description": "PostgreSQL Database name",
                    "default": "notifications"
                },
                "jdbcUrl": {
                    "type": "string",
                    "description": "PostgreSQL connection URI. If specified the postgres.host, postgres.port and postgres.name will be ignored",
                    "default": ""
                },
                "username": {
                    "type": "string",
                    "description": "PostgreSQL username",
                    "default": ""
                },
                "password": {
                    "type": "string",
                    "description": "PostgreSQL password",
                    "default": ""
                },
                "createSchema": {
                    "type": "string",
                    "description": "Whether to create the database schema on startup",
                    "default": "true"
                },
                "existingSecret": {
                    "type": "string",
                    "description": "Name of an existing secret resource containing the PostgreSQL credentials. If specified, the values for postgres.username and postgres.password will be ignored",
                    "default": ""
                }
            }
        },
        "image": {
            "type": "object",
            "properties": {
                "registry": {
                    "type": "string",
                    "description": "*Notifications* image registry",
                    "default": "098669589541.dkr.ecr.eu-west-2.amazonaws.com"
                },
                "repository": {
                    "type": "string",
                    "description": "*Notifications* image name",
                    "default": "telicent-notifications-api-server"
                },
                "tag": {
                    "type": "string",
                    "description": "*Notifications* image tag. If not set, a tag is generated using the appVersion",
                    "default": ""
                },
                "pullPolicy": {
                    "type": "string",
                    "description": "*Notifications* image pull policy",
                    "default": "IfNotPresent"
                },
                "pullSecrets": {
                    "type": "array",
                    "description": "Specify registry secret names as an array",
                    "default": [],
                    "items": {}
                }
            }
        },
        "podAnnotations": {
            "type": "object",
            "description": "Add extra annotations to the Deployment object",
            "default": {}
        },
        "extraEnvs": {
            "type": "array",
            "description": "List of additional environment variables to set in the pod",
            "default": [],
            "items": {}
        },
        "podSecurityContext": {
            "type": "object",
            "properties": {
                "runAsUser": {
                    "type": "number",
                    "description": "Set the provisioning pod's Security Context runAsUser User ID",
                    "default": 185
                },
                "runAsGroup": {
                    "type": "number",
                    "description": "Set the provisioning pod's Security Context runAsGroup Group ID",
                    "default": 185
                },
                "runAsNonRoot": {
                    "type": "boolean",
                    "description": "Set the provisioning pod's Security Context runAsNonRoot",
                    "default": true
                },
                "fsGroup": {
                    "type": "number",
                    "description": "Set the provisioning pod's Group ID for the mounted volumes' filesystem",
                    "default": 185
                },
                "seccompProfile": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "description": "Set the provisioning pod's Security Context seccomp profile",
                            "default": "RuntimeDefault"
                        }
                    }
                }
            }
        },
        "containerSecurityContext": {
            "type": "object",
            "properties": {
                "runAsUser": {
                    "type": "number",
                    "description": "Set containers' Security Context runAsUser User ID",
                    "default": 185
                },
                "runAsGroup": {
                    "type": "number",
                    "description": "Set containers' Security Context runAsGroup Group ID",
                    "default": 185
                },
                "runAsNonRoot": {
                    "type": "boolean",
                    "description": "Set container's Security Context runAsNonRoot",
                    "default": true
                },
                "allowPrivilegeEscalation": {
                    "type": "boolean",
                    "description": "Set container's Security Context allowPrivilegeEscalation",
                    "default": false
                },
                "capabilities": {
                    "type": "object",
                    "properties": {
                        "drop": {
                            "type": "array",
                            "description": "List of capabilities to be dropped",
                            "default": [
                                "ALL"
                            ],
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "seccompProfile": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "description": "Set container's Security Context seccomp profile",
                            "default": "RuntimeDefault"
                        }
                    }
                }
            }
        },
        "resources": {
            "type": "object",
            "description": "Resources for *Notifications* containers",
            "default": {}
        },
        "nodeSelector": {
            "type": "object",
            "description": "Allows you to schedule pods on a node with a label matching the given key-value pair.",
            "default": {}
        },
        "affinity": {
            "type": "object",
            "description": "Allows you to define affinity rules for scheduling pods, see: https://kubernetes.io/docs/concepts/scheduling-eviction/assign-pod-node/",
            "default": {}
        },
        "tolerations": {
            "type": "array",
            "description": "ALlows you to schedule pods on nodes with specified taints, see: https://kubernetes.io/docs/concepts/scheduling-eviction/taint-and-toleration/",
            "default": [],
            "items": {}
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "create": {
                    "type": "boolean",
                    "description": "Specifies whether a service account should be created",
                    "default": true
                },
                "name": {
                    "type": "string",
                    "description": "Name of the ServiceAccount to use. If not set, a name is generated using the fullname",
                    "default": ""
                },
                "annotations": {
                    "type": "object",
                    "description": "Additional custom annotations for the ServiceAccount",
                    "default": {}
                },
                "automount": {
                    "type": "boolean",
                    "description": "Automatically mount a ServiceAccount's API credentials",
                    "default": true
                }
            }
        },
        "service": {
            "type": "object",
            "properties": {
                "port": {
                    "type": "number",
                    "description": "*Notifications* service port",
                    "default": 8080
                },
                "type": {
                    "type": "string",
                    "description": "*Notifications* service type",
                    "default": "ClusterIP"
                }
            }
        },
        "hosts": {
            "type": "object",
            "properties": {
                "enableAutoCorrect": {
                    "type": "boolean",
                    "description": "Prefix 'global.releaseNameTelicentCore' value to each host value. Alternatively, the host value will be used as it is, without any modification",
                    "default": true
                },
                "traefikProxy": {
                    "type": "string",
                    "description": "Traefik Proxy application default host value, as defined by 'service/serviceAccount:port'",
                    "default": "traefik-proxy:8080"
                },
                "auth": {
                    "type": "string",
                    "description": "Auth application default host value, as defined by 'service/serviceAccount:port'",
                    "default": "auth:8080"
                }
            }
        },
        "validation": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Enable JSON Schema validation",
                    "default": false
                },
                "registry": {
                    "type": "object",
                    "properties": {
                        "hostname": {
                            "type": "string",
                            "description": "Name for the Apicurio schema registry",
                            "default": "http://apicurio"
                        },
                        "port": {
                            "type": "number",
                            "description": "Port for the Apicurio schema registry",
                            "default": 8080
                        }
                    }
                }
            }
        }
    }
}
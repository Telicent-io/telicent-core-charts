{
    "title": "Chart Values",
    "type": "object",
    "properties": {
        "enabled": {
            "type": "boolean",
            "description": "Enable Spatial Projector chart",
            "default": false
        },
        "global": {
            "type": "object",
            "properties": {
                "imageRegistry": {
                    "type": "string",
                    "description": "Global image registry",
                    "default": ""
                },
                "imagePullSecrets": {
                    "type": "array",
                    "description": "Global registry secret names as an array",
                    "default": [],
                    "items": {}
                },
                "enterprise": {
                    "type": "boolean",
                    "description": "Enable enterprise mode, adding additional features and configurations",
                    "default": false
                },
                "appHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent application services",
                    "default": "apps.telicent.io"
                },
                "authHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent authentication services, including OIDC providers",
                    "default": "auth.telicent.io"
                },
                "groupsClaim": {
                    "type": "string",
                    "description": "Key used to retrieve groups from the OIDC provider",
                    "default": "groups"
                },
                "jwksUrl": {
                    "type": "string",
                    "description": "Endpoint exposing multiple public keys represented as JWKs (JSON Web Key Set)",
                    "default": "https://{yourAuthdomain}/.well-known/jwks.json"
                },
                "istioNamespace": {
                    "type": "string",
                    "description": "Namespace in which Istio is deployed",
                    "default": "istio-system"
                },
                "istioServiceAccountName": {
                    "type": "string",
                    "description": "Name of the Istio service account",
                    "default": "istio-ingress"
                },
                "istioGatewayName": {
                    "type": "string",
                    "description": "Name of the Istio Gateway Resource (LB operating at the edge of the mesh)",
                    "default": "ingress-gateway"
                },
                "istioVirtualServiceEnabled": {
                    "type": "boolean",
                    "description": "Enable Istio traffic routing to a named destination service",
                    "default": true
                },
                "kafka": {
                    "type": "object",
                    "properties": {
                        "bootstrapServers": {
                            "type": "string",
                            "description": "Comma separated list containing Kafka bootstrap servers",
                            "default": "kafka-bootstrap.kafka.svc.cluster.local:9092"
                        },
                        "existingConfigSecretName": {
                            "type": "string",
                            "description": "Name of an existing secret containing Kafka configuration (preferred over individual settings below for security)",
                            "default": ""
                        },
                        "username": {
                            "type": "string",
                            "description": "Username for Kafka authentication",
                            "default": "your.kafka.username.here"
                        },
                        "password": {
                            "type": "string",
                            "description": "Password for Kafka authentication",
                            "default": "your.kafka.password.here"
                        },
                        "protocol": {
                            "type": "string",
                            "description": "Protocol used for Kafka communication",
                            "default": "SASL_SSL"
                        },
                        "mechanism": {
                            "type": "string",
                            "description": "SASL mechanism used for Kafka authentication",
                            "default": "SCRAM-SHA-512"
                        }
                    }
                },
                "truststore": {
                    "type": "object",
                    "properties": {
                        "existingSecretName": {
                            "type": "string",
                            "description": "Name of an existing secret containing the truststore",
                            "default": ""
                        },
                        "mountPath": {
                            "type": "string",
                            "description": "The mount path for the truststore in the container",
                            "default": "/app/config/truststore"
                        }
                    }
                }
            }
        },
        "configuration": {
            "type": "object",
            "properties": {
                "sourceTopic": {
                    "type": "string",
                    "description": "source topic from which to pull data",
                    "default": "geo"
                }
            }
        },
        "postgres": {
            "type": "object",
            "properties": {
                "uri": {
                    "type": "string",
                    "description": "PostgreSQL connection URL",
                    "default": ""
                },
                "username": {
                    "type": "string",
                    "description": "PostgreSQL username",
                    "default": ""
                },
                "password": {
                    "type": "string",
                    "description": "PostgreSQL password",
                    "default": ""
                },
                "db": {
                    "type": "string",
                    "description": "PostgreSQL Database name",
                    "default": ""
                },
                "existingSecret": {
                    "type": "string",
                    "description": "Name of an existing secret resource containing the PostgreSQL password. If specified, existing secret must contain data for POSTGRES_PASSWORD, and the value for postgres.password will be ignored",
                    "default": ""
                }
            }
        },
        "image": {
            "type": "object",
            "properties": {
                "registry": {
                    "type": "string",
                    "description": "Auth server image registry",
                    "default": "quay.io"
                },
                "repository": {
                    "type": "string",
                    "description": "Auth server image name",
                    "default": "098669589541.dkr.ecr.eu-west-2.amazonaws.com/telicent-smart-cache-spatial-projector"
                },
                "pullPolicy": {
                    "type": "string",
                    "description": "Auth server image pull policy",
                    "default": "IfNotPresent"
                },
                "tag": {
                    "type": "string",
                    "description": "Auth server image tag. If not set, a tag is generated using the appVersion",
                    "default": ""
                },
                "pullSecrets": {
                    "type": "array",
                    "description": "Specify registry secret names as an array",
                    "default": [],
                    "items": {}
                }
            }
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the created ServiceAccount. If not set, a name is generated using the fullname template",
                    "default": ""
                },
                "annotations": {
                    "type": "object",
                    "description": "Additional custom annotations for the ServiceAccount",
                    "default": {}
                }
            }
        },
        "podAnnotations": {
            "type": "object",
            "description": "Add extra annotations to the Deployment object",
            "default": {}
        },
        "extraEnvs": {
            "type": "array",
            "description": "List of additional environment variables to set in the pod",
            "default": [],
            "items": {}
        },
        "podSecurityContext": {
            "type": "object",
            "properties": {
                "runAsUser": {
                    "type": "number",
                    "description": "Set the provisioning pod's Security Context runAsUser User ID",
                    "default": 185
                },
                "runAsGroup": {
                    "type": "number",
                    "description": "Set the provisioning pod's Security Context runAsGroup Group ID",
                    "default": 185
                },
                "runAsNonRoot": {
                    "type": "boolean",
                    "description": "Set the provisioning pod's Security Context runAsNonRoot",
                    "default": true
                },
                "fsGroup": {
                    "type": "number",
                    "description": "Set the provisioning pod's Group ID for the mounted volumes' filesystem",
                    "default": 185
                },
                "seccompProfile": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "description": "Set the provisioning pod's Security Context seccomp profile",
                            "default": "RuntimeDefault"
                        }
                    }
                }
            }
        },
        "containerSecurityContext": {
            "type": "object",
            "properties": {
                "runAsUser": {
                    "type": "number",
                    "description": "Set containers' Security Context runAsUser User ID",
                    "default": 185
                },
                "runAsGroup": {
                    "type": "number",
                    "description": "Set containers' Security Context runAsGroup Group ID",
                    "default": 185
                },
                "runAsNonRoot": {
                    "type": "boolean",
                    "description": "Set container's Security Context runAsNonRoot",
                    "default": true
                },
                "allowPrivilegeEscalation": {
                    "type": "boolean",
                    "description": "Set container's Security Context allowPrivilegeEscalation",
                    "default": false
                },
                "capabilities": {
                    "type": "object",
                    "properties": {
                        "drop": {
                            "type": "array",
                            "description": "List of capabilities to be dropped",
                            "default": [
                                "ALL"
                            ],
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "seccompProfile": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "description": "Set container's Security Context seccomp profile",
                            "default": "RuntimeDefault"
                        }
                    }
                }
            }
        },
        "service": {
            "type": "object",
            "properties": {
                "port": {
                    "type": "number",
                    "description": "Auth server service port",
                    "default": 9000
                },
                "type": {
                    "type": "string",
                    "description": "Auth server service port",
                    "default": "ClusterIP"
                }
            }
        },
        "resources": {
            "type": "object",
            "properties": {
                "requests": {
                    "type": "object",
                    "properties": {
                        "cpu": {
                            "type": "string",
                            "description": "Set containers' CPU request",
                            "default": ""
                        },
                        "memory": {
                            "type": "string",
                            "description": "Set containers' memory request",
                            "default": ""
                        }
                    }
                },
                "limits": {
                    "type": "object",
                    "properties": {
                        "cpu": {
                            "type": "string",
                            "description": "Set containers' CPU limit",
                            "default": ""
                        },
                        "memory": {
                            "type": "string",
                            "description": "Set containers' memory limit",
                            "default": ""
                        }
                    }
                }
            }
        },
        "livenessProbe": {
            "type": "object",
            "properties": {
                "httpGet": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "type": "string",
                            "description": "The path to use for the Auth server liveness probe",
                            "default": "/"
                        },
                        "port": {
                            "type": "string",
                            "description": "The port to use for the Auth server liveness probe",
                            "default": "http"
                        }
                    }
                }
            }
        },
        "readinessProbe": {
            "type": "object",
            "properties": {
                "httpGet": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "type": "string",
                            "description": "The path to use for the Auth server liveness probe",
                            "default": "/"
                        },
                        "port": {
                            "type": "string",
                            "description": "The port to use for the Auth server liveness probe",
                            "default": "http"
                        }
                    }
                }
            }
        },
        "nodeSelector": {
            "type": "object",
            "description": "Allows you to schedule pods on a node with a label matching the given key-value pair.",
            "default": {}
        },
        "affinity": {
            "type": "object",
            "description": "Allows you to define affinity rules for scheduling pods, see: https://kubernetes.io/docs/concepts/scheduling-eviction/assign-pod-node/",
            "default": {}
        },
        "tolerations": {
            "type": "array",
            "description": "ALlows you to schedule pods on nodes with specified taints, see: https://kubernetes.io/docs/concepts/scheduling-eviction/taint-and-toleration/",
            "default": [],
            "items": {}
        },
        "istio": {
            "type": "object",
            "properties": {
                "ingress": {
                    "type": "object",
                    "properties": {
                        "principal": {
                            "type": "string",
                            "description": "Principal used for ingress traffic to this application by the Istio AuthorizationPolicy. If not set, a principal is generated using 'global.istioNamespace' and 'global.istioServiceAccountName'",
                            "default": ""
                        }
                    }
                }
            }
        }
    }
}
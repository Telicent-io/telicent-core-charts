{
    "title": "Chart Values",
    "type": "object",
    "properties": {
        "global": {
            "type": "object",
            "properties": {
                "imageRegistry": {
                    "type": "string",
                    "description": "Global image registry",
                    "default": ""
                },
                "imagePullSecrets": {
                    "type": "array",
                    "description": "Global registry secret names as an array",
                    "default": [],
                    "items": {}
                },
                "enterprise": {
                    "type": "boolean",
                    "description": "Enable enterprise mode, adding additional features and configurations",
                    "default": false
                },
                "appHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent application/ui services",
                    "default": "apps.telicent.io"
                },
                "apiHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent Api services",
                    "default": "api.telicent.io"
                },
                "authHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent authentication services, including OIDC providers",
                    "default": "auth.telicent.io"
                },
                "groupsClaim": {
                    "type": "string",
                    "description": "Key used to retrieve groups from the OIDC provider",
                    "default": "groups"
                },
                "istioNamespace": {
                    "type": "string",
                    "description": "Namespace in which Istio is deployed",
                    "default": "istio-system"
                },
                "istioServiceAccountName": {
                    "type": "string",
                    "description": "Name of the Istio service account",
                    "default": "istio-ingress"
                },
                "istioGatewayName": {
                    "type": "string",
                    "description": "Name of the Istio Gateway Resource (LB operating at the edge of the mesh)",
                    "default": "ingress-gateway"
                },
                "istioVirtualServiceEnabled": {
                    "type": "boolean",
                    "description": "Enable Istio traffic routing to a named destination service",
                    "default": true
                }
            }
        },
        "configuration": {
            "type": "object",
            "properties": {
                "debug": {
                    "type": "boolean",
                    "description": "Enable debug logging",
                    "default": true
                },
                "openidProviderUrl": {
                    "type": "string",
                    "description": "The URL of the OIDC provider",
                    "default": "https://oidc.example.com"
                },
                "scimEnabled": {
                    "type": "boolean",
                    "description": "Enable SCIM user management",
                    "default": true
                },
                "telicentPreviewReleaseName": {
                    "type": "string",
                    "description": "Release name of the Telicent Preview chart",
                    "default": "telicent-preview"
                }
            }
        },
        "nameOverride": {
            "type": "string",
            "description": "String to partially override fullname (will maintain the release name)",
            "default": ""
        },
        "fullnameOverride": {
            "type": "string",
            "description": "String to fully override the generated release name",
            "default": ""
        },
        "namespaceOverride": {
            "type": "string",
            "description": "String to fully override all deployed resources namespace",
            "default": ""
        },
        "commonLabels": {
            "type": "object",
            "description": "Add labels to all the deployed resources",
            "default": {}
        },
        "existingConfigmap": {
            "type": "string",
            "description": "Name of the existing configmap for configuration",
            "default": ""
        },
        "existingCacertConfigmap": {
            "type": "string",
            "description": "Name of the existing configmap for extra certificates",
            "default": ""
        },
        "existingCacertSecretName": {
            "type": "string",
            "description": "Name of the secret containing extra CA certificates",
            "default": ""
        },
        "cacert": {
            "type": "string",
            "description": "Path to the CA certificate file",
            "default": ""
        },
        "mongo": {
            "type": "object",
            "properties": {
                "host": {
                    "type": "string",
                    "description": "MongoDB One or more host addresses, 'host1[:port1][,...hostN[:portN]]'",
                    "default": "<host1>:<port1>,<host2>:<port2>,<host3>:<port3>"
                },
                "database": {
                    "type": "string",
                    "description": "MongoDB database",
                    "default": "access"
                },
                "existingSecret": {
                    "type": "string",
                    "description": "Name of an existing secret resource containing the MongoDB username & password",
                    "default": ""
                },
                "username": {
                    "type": "string",
                    "description": "MongoDB username",
                    "default": ""
                },
                "password": {
                    "type": "string",
                    "description": "MongoDB password",
                    "default": ""
                },
                "connectionStringOptions": {
                    "type": "string",
                    "description": "MongoDB additional connection values",
                    "default": "authMechanism=SCRAM-SHA-256&retryWrites=false"
                },
                "retryRewrites": {
                    "type": "string",
                    "description": "Enable Retryable Writes",
                    "default": "false"
                },
                "existingCaSecret": {
                    "type": "string",
                    "description": "existingCaSecret If you have an existing secret for the CA certificate, you can specify it here. If you've specified to use TLS in the url, you must provide a CA certificate.",
                    "default": ""
                },
                "cacertPath": {
                    "type": "string",
                    "description": "Path to the CA certificate file, must be set if TLS is enabled in the url and mirror the path in the connectionStringOptions",
                    "default": ""
                }
            }
        },
        "replicas": {
            "type": "number",
            "description": "Number of *Access* replicas to deploy",
            "default": 1
        },
        "revisionHistoryLimit": {
            "type": "number",
            "description": "Number of controller revisions to keep",
            "default": 5
        },
        "annotations": {
            "type": "object",
            "description": "Add extra annotations to the deployment object",
            "default": {}
        },
        "podLabels": {
            "type": "object",
            "description": "Add extra labels to the *Access* pod",
            "default": {}
        },
        "podAnnotations": {
            "type": "object",
            "description": "Add extra annotations to the *Access* pod",
            "default": {}
        },
        "extraEnvVars": {
            "type": "array",
            "description": "Array with extra environment variables to add to *Access* pod",
            "default": [],
            "items": {}
        },
        "extraVolumes": {
            "type": "array",
            "description": "Optionally specify extra list of additional volumes",
            "default": [],
            "items": {}
        },
        "extraVolumeMounts": {
            "type": "array",
            "description": "Optionally specify extra list of additional volumeMounts",
            "default": [],
            "items": {}
        },
        "initContainers": {
            "type": "array",
            "description": "Add init containers to the pod",
            "default": [],
            "items": {}
        },
        "sidecars": {
            "type": "array",
            "description": "Add sidecars to the pod",
            "default": [],
            "items": {}
        },
        "image": {
            "type": "object",
            "properties": {
                "registry": {
                    "type": "string",
                    "description": "*Access* image registry",
                    "default": "quay.io"
                },
                "repository": {
                    "type": "string",
                    "description": "*Access* image name",
                    "default": "telicent/telicent-access-api"
                },
                "tag": {
                    "type": "string",
                    "description": "*Access* image tag. If not set, a tag is generated using the appVersion",
                    "default": ""
                },
                "pullPolicy": {
                    "type": "string",
                    "description": "*Access* image pull policy",
                    "default": "IfNotPresent"
                },
                "pullSecrets": {
                    "type": "array",
                    "description": "Specify registry secret names as an array",
                    "default": [],
                    "items": {}
                }
            }
        },
        "resources": {
            "type": "object",
            "properties": {
                "requests": {
                    "type": "object",
                    "properties": {
                        "cpu": {
                            "type": "string",
                            "description": "Set containers' CPU request",
                            "default": "250m"
                        },
                        "memory": {
                            "type": "string",
                            "description": "Set containers' memory request",
                            "default": "512Mi"
                        }
                    }
                },
                "limits": {
                    "type": "object",
                    "properties": {
                        "cpu": {
                            "type": "string",
                            "description": "Set containers' CPU limit",
                            "default": "350m"
                        },
                        "memory": {
                            "type": "string",
                            "description": "Set containers' memory limit",
                            "default": "768Mi"
                        }
                    }
                }
            }
        },
        "containerSecurityContext": {
            "type": "object",
            "properties": {
                "runAsUser": {
                    "type": "number",
                    "description": "Set containers' Security Context runAsUser User ID",
                    "default": 185
                },
                "runAsGroup": {
                    "type": "number",
                    "description": "Set containers' Security Context runAsGroup Group ID",
                    "default": 185
                },
                "runAsNonRoot": {
                    "type": "boolean",
                    "description": "Set container's Security Context runAsNonRoot",
                    "default": true
                },
                "allowPrivilegeEscalation": {
                    "type": "boolean",
                    "description": "Set container's Security Context allowPrivilegeEscalation",
                    "default": false
                },
                "capabilities": {
                    "type": "object",
                    "properties": {
                        "drop": {
                            "type": "array",
                            "description": "List of capabilities to be dropped",
                            "default": [
                                "ALL"
                            ],
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "seccompProfile": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "description": "Set container's Security Context seccomp profile",
                            "default": "RuntimeDefault"
                        }
                    }
                }
            }
        },
        "podSecurityContext": {
            "type": "object",
            "properties": {
                "runAsUser": {
                    "type": "number",
                    "description": "Set the provisioning pod's Security Context runAsUser User ID",
                    "default": 185
                },
                "runAsGroup": {
                    "type": "number",
                    "description": "Set the provisioning pod's Security Context runAsGroup Group ID",
                    "default": 185
                },
                "runAsNonRoot": {
                    "type": "boolean",
                    "description": "Set the provisioning pod's Security Context runAsNonRoot",
                    "default": true
                },
                "fsGroup": {
                    "type": "number",
                    "description": "Set the provisioning pod's Group ID for the mounted volumes' filesystem",
                    "default": 185
                },
                "seccompProfile": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "description": "Set the provisioning pod's Security Context seccomp profile",
                            "default": "RuntimeDefault"
                        }
                    }
                }
            }
        },
        "affinity": {
            "type": "object",
            "description": "Affinity for pod assignment",
            "default": {}
        },
        "nodeSelector": {
            "type": "object",
            "description": "Node labels for pod assignment",
            "default": {}
        },
        "tolerations": {
            "type": "array",
            "description": "Tolerations for pod assignment",
            "default": [],
            "items": {}
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "create": {
                    "type": "boolean",
                    "description": "Specifies whether a service account should be created",
                    "default": true
                },
                "name": {
                    "type": "string",
                    "description": "Name of the ServiceAccount to use. If not set, a name is generated using the fullname",
                    "default": ""
                },
                "annotations": {
                    "type": "object",
                    "description": "Additional custom annotations for the ServiceAccount",
                    "default": {}
                },
                "automount": {
                    "type": "boolean",
                    "description": "Automatically mount a ServiceAccount's API credentials",
                    "default": true
                }
            }
        },
        "service": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "*Access* service name. If not set, a name is generated using the fullname",
                    "default": "access"
                },
                "port": {
                    "type": "number",
                    "description": "*Access* service port",
                    "default": 8080
                },
                "type": {
                    "type": "string",
                    "description": "*Access* service type",
                    "default": "ClusterIP"
                }
            }
        },
        "istio": {
            "type": "object",
            "properties": {
                "ingress": {
                    "type": "object",
                    "properties": {
                        "principal": {
                            "type": "string",
                            "description": "Principal used for ingress traffic by the Istio AuthorizationPolicy. If not set, a principal is generated using Release namespace and serviceAccountName",
                            "default": ""
                        },
                        "serviceAccountName": {
                            "type": "string",
                            "description": "Name of the Ingress service account (traefik and istio supported)",
                            "default": "traefik-proxy"
                        }
                    }
                },
                "userPreferences": {
                    "type": "object",
                    "properties": {
                        "principal": {
                            "type": "string",
                            "description": "Principal used for User Preferences traffic by the Istio AuthorizationPolicy. If not set, a principal is generated using Release namespace and serviceAccountName",
                            "default": ""
                        },
                        "serviceAccountName": {
                            "type": "string",
                            "description": "Name of the User Preferences service account",
                            "default": "user-preferences"
                        }
                    }
                },
                "graph": {
                    "type": "object",
                    "properties": {
                        "principal": {
                            "type": "string",
                            "description": "Principal used for Graph traffic by the Istio AuthorizationPolicy. If not set, a principal is generated using Release namespace and serviceAccountName",
                            "default": ""
                        },
                        "serviceAccountName": {
                            "type": "string",
                            "description": "Name of the Graph service account",
                            "default": "graph"
                        }
                    }
                },
                "search": {
                    "type": "object",
                    "properties": {
                        "principal": {
                            "type": "string",
                            "description": "Principal used for Search traffic by the Istio AuthorizationPolicy. If not set, a principal is generated using Release namespace and serviceAccountName",
                            "default": ""
                        },
                        "serviceAccountName": {
                            "type": "string",
                            "description": "Name of the Search service account",
                            "default": "search"
                        }
                    }
                },
                "paperbackWriter": {
                    "type": "object",
                    "properties": {
                        "principal": {
                            "type": "string",
                            "description": "Principal used for Paperback Writer traffic by the Istio AuthorizationPolicy. If not set, a principal is generated using Release namespace and serviceAccountName",
                            "default": ""
                        },
                        "serviceAccountName": {
                            "type": "string",
                            "description": "Name of the Paperback Writer service account",
                            "default": "paperback-writer"
                        }
                    }
                }
            }
        }
    }
}
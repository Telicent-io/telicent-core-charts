{
    "title": "Chart Values",
    "type": "object",
    "properties": {
        "enabled": {
            "type": "boolean",
            "description": "Enable Canonicals Ontology chart",
            "default": true
        },
        "global": {
            "type": "object",
            "properties": {
                "imageRegistry": {
                    "type": "string",
                    "description": "Global image registry",
                    "default": ""
                },
                "imagePullSecrets": {
                    "type": "array",
                    "description": "Global registry secret names as an array",
                    "default": [],
                    "items": {}
                },
                "kafka": {
                    "type": "object",
                    "properties": {
                        "bootstrapServers": {
                            "type": "string",
                            "description": "Comma separated list containing Kafka bootstrap servers",
                            "default": "kafka-bootstrap.kafka.svc.cluster.local:9092"
                        },
                        "existingConfigSecretName": {
                            "type": "string",
                            "description": "Name of an existing secret containing Kafka configuration (preferred over individual settings below for security)",
                            "default": ""
                        },
                        "username": {
                            "type": "string",
                            "description": "Username for Kafka authentication",
                            "default": ""
                        },
                        "password": {
                            "type": "string",
                            "description": "Password for Kafka authentication",
                            "default": ""
                        },
                        "protocol": {
                            "type": "string",
                            "description": "Protocol used for Kafka communication",
                            "default": "SASL_SSL"
                        },
                        "mechanism": {
                            "type": "string",
                            "description": "SASL mechanism used for Kafka authentication",
                            "default": "SCRAM-SHA-512"
                        }
                    }
                }
            }
        },
        "canonicals-ontology-json-validation-mapper": {
            "type": "object",
            "properties": {
                "schema": {
                    "type": "object",
                    "properties": {
                        "existingConfigMapName": {
                            "type": "string",
                            "description": "Name of the ConfigMap containing the JSON validation schema; defaults to the ConfigMap created by this chart from `files/canonical-ontology.schema.json`",
                            "default": "canonicals-ontology-schema"
                        }
                    }
                },
                "configuration": {
                    "type": "object",
                    "properties": {
                        "sourceTopic": {
                            "type": "string",
                            "description": "Topic the validation mapper reads raw canonical ontology messages from",
                            "default": "canonical.ontology.raw"
                        },
                        "targetTopic": {
                            "type": "string",
                            "description": "Topic the validation mapper writes validated canonical ontology messages to",
                            "default": "canonical.ontology.validated"
                        },
                        "componentOf": {
                            "type": "string",
                            "description": "Pipeline this instance of the validation mapper belongs to",
                            "default": "canonicals-ontology"
                        }
                    }
                }
            }
        }
    }
}
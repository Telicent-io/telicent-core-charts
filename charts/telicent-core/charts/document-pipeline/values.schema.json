{
    "title": "Chart Values",
    "type": "object",
    "properties": {
        "enabled": {
            "type": "boolean",
            "description": "Enable Document Pipeline chart",
            "default": false
        },
        "global": {
            "type": "object",
            "properties": {
                "imageRegistry": {
                    "type": "string",
                    "description": "Global image registry",
                    "default": ""
                },
                "imagePullSecrets": {
                    "type": "array",
                    "description": "Global registry secret names as an array",
                    "default": [],
                    "items": {}
                },
                "appHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent application/ui services. This value cannot be changed after it is set",
                    "default": ""
                },
                "apiHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent Api services. This value cannot be changed after it is set",
                    "default": ""
                },
                "authHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent authentication services, including OIDC providers. This value cannot be changed after it is set",
                    "default": ""
                },
                "kafka": {
                    "type": "object",
                    "properties": {
                        "bootstrapServers": {
                            "type": "string",
                            "description": "Comma separated list containing Kafka bootstrap servers",
                            "default": "kafka-bootstrap.kafka.svc.cluster.local:9092"
                        },
                        "existingConfigSecretName": {
                            "type": "string",
                            "description": "Name of an existing secret containing Kafka configuration (preferred over individual settings below for security)",
                            "default": ""
                        },
                        "username": {
                            "type": "string",
                            "description": "Username for Kafka authentication",
                            "default": "your.kafka.username.here"
                        },
                        "password": {
                            "type": "string",
                            "description": "Password for Kafka authentication",
                            "default": "your.kafka.password.here"
                        },
                        "protocol": {
                            "type": "string",
                            "description": "Protocol used for Kafka communication",
                            "default": "SASL_SSL"
                        },
                        "mechanism": {
                            "type": "string",
                            "description": "SASL mechanism used for Kafka authentication",
                            "default": "SCRAM-SHA-512"
                        }
                    }
                },
                "truststore": {
                    "type": "object",
                    "properties": {
                        "existingSecret": {
                            "type": "string",
                            "description": "Name of an existing secret containing the truststore",
                            "default": ""
                        },
                        "mountPath": {
                            "type": "string",
                            "description": "The mount path for the truststore in the container",
                            "default": "/app/config/truststore"
                        }
                    }
                }
            }
        },
        "smart-cache-documents": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Enable the smart-cache-documents components",
                    "default": true
                },
                "resources": {
                    "type": "object",
                    "description": "Default resources applied to the smart-cache-documents containers",
                    "default": {}
                },
                "podSecurityContext": {
                    "type": "object",
                    "properties": {
                        "runAsUser": {
                            "type": "number",
                            "description": "Set the pod's Security Context runAsUser User ID",
                            "default": 185
                        },
                        "runAsGroup": {
                            "type": "number",
                            "description": "Set the pod's Security Context runAsGroup Group ID",
                            "default": 185
                        },
                        "runAsNonRoot": {
                            "type": "boolean",
                            "description": "Set the pod's Security Context runAsNonRoot",
                            "default": true
                        },
                        "fsGroup": {
                            "type": "number",
                            "description": "Set the pod's Group ID for the mounted volumes' filesystem",
                            "default": 185
                        },
                        "seccompProfile": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "description": "Set the pod's Security Context seccomp profile",
                                    "default": "RuntimeDefault"
                                }
                            }
                        }
                    }
                },
                "containerSecurityContext": {
                    "type": "object",
                    "properties": {
                        "runAsUser": {
                            "type": "number",
                            "description": "Set containers' Security Context runAsUser User ID",
                            "default": 185
                        },
                        "runAsGroup": {
                            "type": "number",
                            "description": "Set containers' Security Context runAsGroup Group ID",
                            "default": 185
                        },
                        "runAsNonRoot": {
                            "type": "boolean",
                            "description": "Set container's Security Context runAsNonRoot",
                            "default": true
                        },
                        "allowPrivilegeEscalation": {
                            "type": "boolean",
                            "description": "Set container's Security Context allowPrivilegeEscalation",
                            "default": false
                        },
                        "capabilities": {
                            "type": "object",
                            "properties": {
                                "drop": {
                                    "type": "array",
                                    "description": "List of capabilities to be dropped",
                                    "default": [
                                        "ALL"
                                    ],
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            }
                        },
                        "seccompProfile": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "description": "Set container's Security Context seccomp profile",
                                    "default": "RuntimeDefault"
                                }
                            }
                        }
                    }
                },
                "serviceAccount": {
                    "type": "object",
                    "properties": {
                        "create": {
                            "type": "boolean",
                            "description": "Specifies whether a service account should be created",
                            "default": true
                        },
                        "automount": {
                            "type": "boolean",
                            "description": "Automatically mount a ServiceAccount's API credentials",
                            "default": true
                        },
                        "annotations": {
                            "type": "object",
                            "description": "Annotations to add to the service account",
                            "default": {}
                        },
                        "name": {
                            "type": "string",
                            "description": "The name of the service account to use. If not set and create is true, a name is generated using the fullname template",
                            "default": ""
                        }
                    }
                },
                "hosts": {
                    "type": "object",
                    "properties": {
                        "enableAutoCorrect": {
                            "type": "boolean",
                            "description": "Allow for the release name to be automatically pre-fixed to each host value when required",
                            "default": true
                        },
                        "auth": {
                            "type": "string",
                            "description": "Auth application default host value, as defined by 'service/serviceAccount:port'",
                            "default": "auth:8080"
                        },
                        "traefikProxy": {
                            "type": "string",
                            "description": "Traefik Proxy application default host value, as defined by 'service/serviceAccount:port'",
                            "default": "traefik-proxy:8080"
                        }
                    }
                },
                "httpIngester": {
                    "type": "object",
                    "properties": {
                        "java": {
                            "type": "object",
                            "properties": {
                                "jvmOptions": {
                                    "type": "string",
                                    "description": "Java options to pass to the JVM",
                                    "default": "-XX:MaxRAMPercentage=80.0"
                                }
                            }
                        },
                        "routes": {
                            "type": "array",
                            "description": "A unique name for the route",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "description": "A unique name for the route"
                                    },
                                    "topic": {
                                        "type": "string",
                                        "description": "The destination Kafka topic for the route"
                                    },
                                    "securityLabel": {
                                        "type": "string",
                                        "description": "In this test configuration the label is simply test=true"
                                    },
                                    "namespace": {
                                        "type": "string",
                                        "description": "The Namespace URI that will be used to assign a unique URI to a document URIs are generated deterministically based on this and the ingested document content"
                                    },
                                    "headers": {
                                        "type": "array",
                                        "description": "The Owner header, configured such that even if the header is present in the request then the defaultValue here takes precedence",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "name": {
                                                    "type": "string",
                                                    "description": "The EDH/IDH policy information header"
                                                },
                                                "defaultValue": {
                                                    "type": "string",
                                                    "description": "The default value for the EDH/IDH policy information header"
                                                },
                                                "priority": {
                                                    "type": "string",
                                                    "description": "The priority for the EDH/IDH policy information header"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "configMap": {
                            "type": "object",
                            "properties": {
                                "existingEnvConfigMap": {
                                    "type": "string",
                                    "description": "Name of existing configmap containing *HTTP Ingester* Environment Configuration",
                                    "default": ""
                                },
                                "existingRoutesConfigMap": {
                                    "type": "string",
                                    "description": "Name of existing configmap containing Routes Configuration",
                                    "default": ""
                                }
                            }
                        },
                        "replicas": {
                            "type": "number",
                            "description": "Number of replicas to deploy",
                            "default": 1
                        },
                        "service": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "description": "*HTTP Ingester* service name. If not set, a name is generated using the fullname",
                                    "default": ""
                                },
                                "port": {
                                    "type": "number",
                                    "description": "*HTTP Ingester* service port",
                                    "default": 8080
                                },
                                "type": {
                                    "type": "string",
                                    "description": "*HTTP Ingester* service type",
                                    "default": "ClusterIP"
                                }
                            }
                        }
                    }
                },
                "contentExtractor": {
                    "type": "object",
                    "properties": {
                        "topics": {
                            "type": "object",
                            "properties": {
                                "inputTopic": {
                                    "type": "string",
                                    "description": "The Kafka topic from which the *Content Extractor* will consume messages",
                                    "default": "document.extractrequest"
                                },
                                "outputTopic": {
                                    "type": "string",
                                    "description": "The Kafka topic to which the *Content Extractor* will produce messages",
                                    "default": "document.textandmetadata"
                                },
                                "dlqTopic": {
                                    "type": "string",
                                    "description": "The Kafka topic to which the *Content Extractor* will produce dead-lettered messages",
                                    "default": "document.extractrequest.dlq"
                                }
                            }
                        },
                        "replicas": {
                            "type": "number",
                            "description": "The number of replicas for the *Content Extractor*",
                            "default": 1
                        }
                    }
                },
                "contentIndexer": {
                    "type": "object",
                    "properties": {
                        "java": {
                            "type": "object",
                            "properties": {
                                "jvmOptions": {
                                    "type": "string",
                                    "description": "JVM options for the application",
                                    "default": "-XX:MaxRAMPercentage=80.0"
                                }
                            }
                        },
                        "elastic": {
                            "type": "object",
                            "properties": {
                                "host": {
                                    "type": "string",
                                    "description": "Elastic/OpenSearch host (include protocol, https or http)",
                                    "default": "https://your.opensearch.host"
                                },
                                "port": {
                                    "type": "string",
                                    "description": "Elastic/OpenSearch port number",
                                    "default": "443"
                                },
                                "opensearchCompatibility": {
                                    "type": "boolean",
                                    "description": "Enable OpenSearch compatibility",
                                    "default": true
                                },
                                "index": {
                                    "type": "string",
                                    "description": "Elastic/OpenSearch index to be used",
                                    "default": "doc-content"
                                },
                                "topic": {
                                    "type": "string",
                                    "description": "The Kafka topic(s) from which the content indexer will consume messages",
                                    "default": "document.textandmetadata,document.entities"
                                },
                                "dlqTopic": {
                                    "type": "string",
                                    "description": "The Kafka topic to which the content indexer will produce dead-lettered messages",
                                    "default": "document.textandmetadata.dlq"
                                },
                                "existingSecret": {
                                    "type": "string",
                                    "description": "Name of an existing secret. The secret must contain 2 keys: 'username', 'password'",
                                    "default": ""
                                },
                                "username": {
                                    "type": "string",
                                    "description": "OpenSearch/Elastic username (prefer existingSecret)",
                                    "default": ""
                                },
                                "password": {
                                    "type": "string",
                                    "description": "OpenSearch/Elastic user password (prefer existingSecret)",
                                    "default": ""
                                }
                            }
                        },
                        "replicas": {
                            "type": "number",
                            "description": "Number of replicas to deploy",
                            "default": 1
                        }
                    }
                },
                "catalogueUpdater": {
                    "type": "object",
                    "properties": {
                        "topics": {
                            "type": "object",
                            "properties": {
                                "inputTopic": {
                                    "type": "string",
                                    "description": "The Kafka topic from which the *Catalogue Updater* will consume messages",
                                    "default": "document.textandmetadata"
                                },
                                "outputTopic": {
                                    "type": "string",
                                    "description": "The Kafka topic to which the *Catalogue Updater* will produce",
                                    "default": "catalog"
                                },
                                "debounceWindowMs": {
                                    "type": "number",
                                    "description": "The debounce window in milliseconds",
                                    "default": 30000
                                },
                                "flushIntervalMs": {
                                    "type": "number",
                                    "description": "The flush interval in milliseconds",
                                    "default": 60000
                                },
                                "maxBufferSize": {
                                    "type": "number",
                                    "description": "The maximum buffer size",
                                    "default": 100
                                },
                                "dlqTopic": {
                                    "type": "string",
                                    "description": "The Kafka topic to which the *Catalogue Updater* will produce dead-lettered messages",
                                    "default": "document.extractrequest.dlq"
                                }
                            }
                        },
                        "replicas": {
                            "type": "number",
                            "description": "The number of replicas for the *Catalogue Updater*",
                            "default": 1
                        }
                    }
                }
            }
        },
        "rdf-document-tagger-dc": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Enable the Content Tagger component",
                    "default": true
                },
                "hosts": {
                    "type": "object",
                    "properties": {
                        "enableAutoCorrect": {
                            "type": "boolean",
                            "description": "Allow for the release name to be automatically pre-fixed to each host value when required",
                            "default": true
                        },
                        "auth": {
                            "type": "string",
                            "description": "Auth application default host value, as defined by 'service/serviceAccount:port'",
                            "default": "auth:8080"
                        },
                        "traefikProxy": {
                            "type": "string",
                            "description": "Traefik Proxy application default host value, as defined by 'service/serviceAccount:port'",
                            "default": "traefik-proxy:8080"
                        }
                    }
                },
                "topics": {
                    "type": "object",
                    "properties": {
                        "inputTopic": {
                            "type": "string",
                            "description": "The Kafka topic from which the *Content Tagger* will consume messages",
                            "default": "document.textandmetadata"
                        },
                        "outputTopic": {
                            "type": "string",
                            "description": "The Kafka topic to which the *Content Tagger* will produce",
                            "default": "knowledge"
                        },
                        "rdfTaggerDataUriStub": {
                            "type": "string",
                            "description": "The URI for the RDF Tagger service",
                            "default": "http://telicent.io/data#"
                        },
                        "dctUri": {
                            "type": "string",
                            "description": "The URI for Dublin Core Terms",
                            "default": "http://purl.org/dc/terms/"
                        },
                        "iesUri": {
                            "type": "string",
                            "description": "The URI for the IES Ontology",
                            "default": "http://ies.data.gov.uk/ontology/ies4#"
                        },
                        "tontUri": {
                            "type": "string",
                            "description": "The URI for the Telicent Ontology",
                            "default": "http://telicent.io/ontology/"
                        },
                        "iso3166Uri": {
                            "type": "string",
                            "description": "The URI for the ISO 3166 standard",
                            "default": "http://iso.org/iso3166/country#"
                        },
                        "loggingLevel": {
                            "type": "string",
                            "description": "The logging level for the *Content Tagger*, e.g., DEBUG, INFO, WARN, ERROR",
                            "default": "INFO"
                        },
                        "kafkaConfigMode": {
                            "type": "string",
                            "description": "The configuration mode for Kafka, either 'basic' or 'toml'",
                            "default": "toml"
                        }
                    }
                },
                "replicas": {
                    "type": "number",
                    "description": "The number of replicas for the *Content Tagger*",
                    "default": 1
                },
                "podSecurityContext": {
                    "type": "object",
                    "properties": {
                        "runAsUser": {
                            "type": "number",
                            "description": "Set the pod's Security Context runAsUser User ID",
                            "default": 185
                        },
                        "runAsGroup": {
                            "type": "number",
                            "description": "Set the pod's Security Context runAsGroup Group ID",
                            "default": 185
                        },
                        "runAsNonRoot": {
                            "type": "boolean",
                            "description": "Set the pod's Security Context runAsNonRoot",
                            "default": true
                        },
                        "fsGroup": {
                            "type": "number",
                            "description": "Set the pod's Group ID for the mounted volumes' filesystem",
                            "default": 185
                        },
                        "seccompProfile": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "description": "Set the pod's Security Context seccomp profile",
                                    "default": "RuntimeDefault"
                                }
                            }
                        }
                    }
                },
                "containerSecurityContext": {
                    "type": "object",
                    "properties": {
                        "runAsUser": {
                            "type": "number",
                            "description": "Set containers' Security Context runAsUser User ID",
                            "default": 185
                        },
                        "runAsGroup": {
                            "type": "number",
                            "description": "Set containers' Security Context runAsGroup Group ID",
                            "default": 185
                        },
                        "runAsNonRoot": {
                            "type": "boolean",
                            "description": "Set container's Security Context runAsNonRoot",
                            "default": true
                        },
                        "allowPrivilegeEscalation": {
                            "type": "boolean",
                            "description": "Set container's Security Context allowPrivilegeEscalation",
                            "default": false
                        },
                        "capabilities": {
                            "type": "object",
                            "properties": {
                                "drop": {
                                    "type": "array",
                                    "description": "List of capabilities to be dropped",
                                    "default": [
                                        "ALL"
                                    ],
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            }
                        },
                        "seccompProfile": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "description": "Set container's Security Context seccomp profile",
                                    "default": "RuntimeDefault"
                                }
                            }
                        }
                    }
                }
            }
        },
        "pipeline-entity-extraction": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Enable the Entity Extractor component",
                    "default": true
                },
                "hosts": {
                    "type": "object",
                    "properties": {
                        "enableAutoCorrect": {
                            "type": "boolean",
                            "description": "Allow for the release name to be automatically pre-fixed to each host value when required",
                            "default": true
                        },
                        "auth": {
                            "type": "string",
                            "description": "Auth application default host value, as defined by 'service/serviceAccount:port'",
                            "default": "auth:8080"
                        },
                        "traefikProxy": {
                            "type": "string",
                            "description": "Traefik Proxy application default host value, as defined by 'service/serviceAccount:port'",
                            "default": "traefik-proxy:8080"
                        }
                    }
                },
                "topics": {
                    "type": "object",
                    "properties": {
                        "inputTopic": {
                            "type": "string",
                            "description": "The Kafka topic from which the entity extractor will consume messages",
                            "default": "document.textandmetadata"
                        },
                        "outputTopic": {
                            "type": "string",
                            "description": "The Kafka topic to which the entity extractor will produce",
                            "default": "document.entities"
                        },
                        "kafkaConfigMode": {
                            "type": "string",
                            "description": "The configuration mode for Kafka, either 'basic' or 'toml'",
                            "default": "toml"
                        }
                    }
                },
                "replicas": {
                    "type": "number",
                    "description": "Number of replicas to deploy",
                    "default": 1
                },
                "podSecurityContext": {
                    "type": "object",
                    "properties": {
                        "runAsUser": {
                            "type": "number",
                            "description": "Set the pod's Security Context runAsUser User ID",
                            "default": 185
                        },
                        "runAsGroup": {
                            "type": "number",
                            "description": "Set the pod's Security Context runAsGroup Group ID",
                            "default": 185
                        },
                        "runAsNonRoot": {
                            "type": "boolean",
                            "description": "Set the pod's Security Context runAsNonRoot",
                            "default": true
                        },
                        "fsGroup": {
                            "type": "number",
                            "description": "Set the pod's Group ID for the mounted volumes' filesystem",
                            "default": 185
                        },
                        "seccompProfile": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "description": "Set the pod's Security Context seccomp profile",
                                    "default": "RuntimeDefault"
                                }
                            }
                        }
                    }
                },
                "containerSecurityContext": {
                    "type": "object",
                    "properties": {
                        "runAsUser": {
                            "type": "number",
                            "description": "Set containers' Security Context runAsUser User ID",
                            "default": 185
                        },
                        "runAsGroup": {
                            "type": "number",
                            "description": "Set containers' Security Context runAsGroup Group ID",
                            "default": 185
                        },
                        "runAsNonRoot": {
                            "type": "boolean",
                            "description": "Set container's Security Context runAsNonRoot",
                            "default": true
                        },
                        "allowPrivilegeEscalation": {
                            "type": "boolean",
                            "description": "Set container's Security Context allowPrivilegeEscalation",
                            "default": false
                        },
                        "capabilities": {
                            "type": "object",
                            "properties": {
                                "drop": {
                                    "type": "array",
                                    "description": "List of capabilities to be dropped",
                                    "default": [
                                        "ALL"
                                    ],
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            }
                        },
                        "seccompProfile": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "description": "Set container's Security Context seccomp profile",
                                    "default": "RuntimeDefault"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
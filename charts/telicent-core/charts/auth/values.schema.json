{
    "title": "Chart Values",
    "type": "object",
    "properties": {
        "global": {
            "type": "object",
            "properties": {
                "imageRegistry": {
                    "type": "string",
                    "description": "Global image registry",
                    "default": ""
                },
                "imagePullSecrets": {
                    "type": "array",
                    "description": "Global registry secret names as an array",
                    "default": [],
                    "items": {}
                },
                "enterprise": {
                    "type": "boolean",
                    "description": "Enable enterprise mode, adding additional features and configurations",
                    "default": false
                },
                "appHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent application/ui services",
                    "default": "apps.telicent.io"
                },
                "apiHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent Api services",
                    "default": "api.telicent.io"
                },
                "authHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent authentication services, including OIDC providers",
                    "default": "auth.telicent.io"
                },
                "groupsClaim": {
                    "type": "string",
                    "description": "Key used to retrieve groups from the OIDC provider",
                    "default": "groups"
                },
                "istioNamespace": {
                    "type": "string",
                    "description": "Namespace in which Istio is deployed",
                    "default": "istio-system"
                },
                "istioServiceAccountName": {
                    "type": "string",
                    "description": "Name of the Istio service account",
                    "default": "istio-ingress"
                },
                "istioGatewayName": {
                    "type": "string",
                    "description": "Name of the Istio Gateway Resource (LB operating at the edge of the mesh)",
                    "default": "ingress-gateway"
                },
                "istioVirtualServiceEnabled": {
                    "type": "boolean",
                    "description": "Enable Istio traffic routing to a named destination service",
                    "default": false
                }
            }
        },
        "configuration": {
            "type": "object",
            "properties": {
                "existingEnvConfigMap": {
                    "type": "string",
                    "description": "Name of existing configmap containing *Auth* Environment Configuration",
                    "default": ""
                },
                "javaOptions": {
                    "type": "string",
                    "description": "JVM options for the application",
                    "default": "-XX:MaxRAMPercentage=80.0"
                },
                "cookieParentDomain": {
                    "type": "string",
                    "description": "Cookie domain scope",
                    "default": ".telicent.io"
                },
                "cookieSecure": {
                    "type": "boolean",
                    "description": "Enable secure cookies",
                    "default": true
                },
                "superUserIdentifier": {
                    "type": "string",
                    "description": "Super user identification if blank all users will be super users",
                    "default": ""
                }
            }
        },
        "postgresSql": {
            "type": "object",
            "properties": {
                "uri": {
                    "type": "string",
                    "description": "PostgreSQL connection URI",
                    "default": ""
                },
                "existingSecret": {
                    "type": "string",
                    "description": "Name of an existing secret. The secret must contain 2 keys: 'username', 'password'",
                    "default": ""
                },
                "username": {
                    "type": "string",
                    "description": "PostgreSQL username",
                    "default": ""
                },
                "password": {
                    "type": "string",
                    "description": "PostgreSQL password",
                    "default": ""
                }
            }
        },
        "idp": {
            "type": "object",
            "properties": {
                "issuerUrl": {
                    "type": "string",
                    "description": "The OpenID Connect issuer URL",
                    "default": ""
                },
                "authorizationPath": {
                    "type": "string",
                    "description": "The path to use in combination with the issuer URL for authorization",
                    "default": "/auth"
                },
                "jwksPath": {
                    "type": "string",
                    "description": "The path to use in combination with the issuer URL for JWKS",
                    "default": "/keys"
                },
                "tokenPath": {
                    "type": "string",
                    "description": "The path to use in combination with the issuer URL for generating tokens",
                    "default": "/token"
                },
                "clientName": {
                    "type": "string",
                    "description": "The OAuth Client Name (used for display)",
                    "default": ""
                },
                "emailClaim": {
                    "type": "string",
                    "description": "The OIDC claim containing the user's email",
                    "default": "email"
                },
                "existingSecret": {
                    "type": "string",
                    "description": "Name of an existing secret. The secret must contain 2 keys: 'clientid', 'clientsecret'",
                    "default": ""
                },
                "clientId": {
                    "type": "string",
                    "description": "The OAuth Client ID",
                    "default": ""
                },
                "clientSecret": {
                    "type": "string",
                    "description": "The OAuth Client Secret",
                    "default": ""
                }
            }
        },
        "forwardAuth": {
            "type": "object",
            "properties": {
                "existingSecret": {
                    "type": "string",
                    "description": "Name of an existing secret. The secret must contain 1 key: 'header'",
                    "default": ""
                },
                "header": {
                    "type": "string",
                    "description": "The header value to be associated with the `X-ForwardAuth-Secret`.",
                    "default": ""
                }
            }
        },
        "clients": {
            "type": "object",
            "properties": {
                "public": {
                    "type": "array",
                    "description": "A list of public client objects",
                    "default": [],
                    "items": {}
                },
                "confidential": {
                    "type": "array",
                    "description": "A list of confidential client objects",
                    "default": [],
                    "items": {}
                },
                "existingConfigMap": {
                    "type": "string",
                    "description": "Name of an existing config map resource containing all required public and confidential clients. If specified, the values for clients.public and clients.confidential will be ignored",
                    "default": ""
                }
            }
        },
        "nameOverride": {
            "type": "string",
            "description": "String to partially override fullname (will maintain the release name)",
            "default": ""
        },
        "fullnameOverride": {
            "type": "string",
            "description": "String to fully override the generated release name",
            "default": ""
        },
        "namespaceOverride": {
            "type": "string",
            "description": "String to fully override all deployed resources namespace",
            "default": ""
        },
        "commonLabels": {
            "type": "object",
            "description": "Add labels to all the deployed resources",
            "default": {}
        },
        "replicas": {
            "type": "number",
            "description": "Number of *Auth* replicas to deploy",
            "default": 1
        },
        "revisionHistoryLimit": {
            "type": "number",
            "description": "Number of controller revisions to keep",
            "default": 5
        },
        "annotations": {
            "type": "object",
            "description": "Add extra annotations to the Deployment Object",
            "default": {}
        },
        "podLabels": {
            "type": "object",
            "description": "Add extra labels to the *Auth* pod",
            "default": {}
        },
        "podAnnotations": {
            "type": "object",
            "description": "Add extra annotations to the *Auth* pod",
            "default": {}
        },
        "extraEnvVars": {
            "type": "array",
            "description": "Array with extra environment variables to add to *Auth* pod",
            "default": [],
            "items": {}
        },
        "extraVolumes": {
            "type": "array",
            "description": "Additional containers to be added to the *Auth* pod",
            "default": [],
            "items": {}
        },
        "extraVolumeMounts": {
            "type": "array",
            "description": "Optionally specify extra list of additional volumeMounts",
            "default": [],
            "items": {}
        },
        "initContainers": {
            "type": "array",
            "description": "Add init containers to the pod",
            "default": [],
            "items": {}
        },
        "sidecars": {
            "type": "array",
            "description": "Add sidecars to the pod.",
            "default": [],
            "items": {}
        },
        "image": {
            "type": "object",
            "properties": {
                "registry": {
                    "type": "string",
                    "description": "*Auth* image registry",
                    "default": "REGISTRY_NAME"
                },
                "repository": {
                    "type": "string",
                    "description": "*Auth* image name",
                    "default": "REPOSITORY_NAME/telicent-auth-server"
                },
                "tag": {
                    "type": "string",
                    "description": "*Auth* image tag. If not set, a tag is generated using the appVersion",
                    "default": ""
                },
                "pullPolicy": {
                    "type": "string",
                    "description": "*Auth* image pull policy",
                    "default": "IfNotPresent"
                },
                "pullSecrets": {
                    "type": "array",
                    "description": "Specify registry secret names as an array",
                    "default": [],
                    "items": {}
                }
            }
        },
        "resources": {
            "type": "object",
            "properties": {
                "requests": {
                    "type": "object",
                    "properties": {
                        "cpu": {
                            "type": "string",
                            "description": "Set containers' CPU request",
                            "default": "700m"
                        },
                        "memory": {
                            "type": "string",
                            "description": "Set containers' memory request",
                            "default": "1024Mi"
                        }
                    }
                },
                "limits": {
                    "type": "object",
                    "properties": {
                        "cpu": {
                            "type": "string",
                            "description": "Set containers' CPU limit",
                            "default": "1500m"
                        },
                        "memory": {
                            "type": "string",
                            "description": "Set containers' memory limit",
                            "default": "2048Mi"
                        }
                    }
                }
            }
        },
        "containerSecurityContext": {
            "type": "object",
            "properties": {
                "runAsUser": {
                    "type": "number",
                    "description": "Set containers' Security Context runAsUser User ID",
                    "default": 185
                },
                "runAsGroup": {
                    "type": "number",
                    "description": "Set containers' Security Context runAsGroup Group ID",
                    "default": 185
                },
                "runAsNonRoot": {
                    "type": "boolean",
                    "description": "Set container's Security Context runAsNonRoot",
                    "default": true
                },
                "allowPrivilegeEscalation": {
                    "type": "boolean",
                    "description": "Set container's Security Context allowPrivilegeEscalation",
                    "default": false
                },
                "capabilities": {
                    "type": "object",
                    "properties": {
                        "drop": {
                            "type": "array",
                            "description": "List of capabilities to be dropped",
                            "default": [
                                "ALL"
                            ],
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "seccompProfile": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "description": "Set container's Security Context seccomp profile",
                            "default": "RuntimeDefault"
                        }
                    }
                }
            }
        },
        "podSecurityContext": {
            "type": "object",
            "properties": {
                "runAsUser": {
                    "type": "number",
                    "description": "Set the provisioning pod's Security Context runAsUser User ID",
                    "default": 185
                },
                "runAsGroup": {
                    "type": "number",
                    "description": "Set the provisioning pod's Security Context runAsGroup Group ID",
                    "default": 185
                },
                "runAsNonRoot": {
                    "type": "boolean",
                    "description": "Set the provisioning pod's Security Context runAsNonRoot",
                    "default": true
                },
                "fsGroup": {
                    "type": "number",
                    "description": "Set the provisioning pod's Group ID for the mounted volumes' filesystem",
                    "default": 185
                },
                "seccompProfile": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "description": "Set the provisioning pod's Security Context seccomp profile",
                            "default": "RuntimeDefault"
                        }
                    }
                }
            }
        },
        "affinity": {
            "type": "object",
            "description": "Affinity for pod assignment",
            "default": {}
        },
        "nodeSelector": {
            "type": "object",
            "description": "Node labels for pod assignment",
            "default": {}
        },
        "tolerations": {
            "type": "array",
            "description": "Tolerations for pod assignment",
            "default": [],
            "items": {}
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "create": {
                    "type": "boolean",
                    "description": "Specifies whether a service account should be created",
                    "default": true
                },
                "name": {
                    "type": "string",
                    "description": "Name of the ServiceAccount to use. If not set, a name is generated using the fullname",
                    "default": ""
                },
                "annotations": {
                    "type": "object",
                    "description": "Additional custom annotations for the ServiceAccount",
                    "default": {}
                },
                "automount": {
                    "type": "boolean",
                    "description": "Automatically mount a ServiceAccount's API credentials",
                    "default": true
                }
            }
        },
        "service": {
            "type": "object",
            "properties": {
                "port": {
                    "type": "number",
                    "description": "*Auth* service port",
                    "default": 9000
                },
                "type": {
                    "type": "string",
                    "description": "*Auth* service port",
                    "default": "ClusterIP"
                }
            }
        },
        "istio": {
            "type": "object",
            "properties": {
                "ingress": {
                    "type": "object",
                    "properties": {
                        "principal": {
                            "type": "string",
                            "description": "Principal used for ingress traffic by the Istio AuthorizationPolicy. If not set, a principal is generated using Release namespace and serviceAccountName",
                            "default": ""
                        },
                        "serviceAccountName": {
                            "type": "string",
                            "description": "Name of the Ingress service account (traefik and istio supported)",
                            "default": "traefik-proxy"
                        }
                    }
                }
            }
        }
    }
}
{
    "title": "Chart Values",
    "type": "object",
    "properties": {
        "global": {
            "type": "object",
            "properties": {
                "imageRegistry": {
                    "type": "string",
                    "description": "Global image registry",
                    "default": ""
                },
                "imagePullSecrets": {
                    "type": "array",
                    "description": "Global registry secret names as an array",
                    "default": [],
                    "items": {}
                },
                "enterprise": {
                    "type": "boolean",
                    "description": "Enable enterprise mode, adding additional features and configurations",
                    "default": false
                },
                "appHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent application services",
                    "default": "apps.telicent.io"
                },
                "authHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent authentication services, including OIDC providers",
                    "default": "auth.telicent.io"
                },
                "groupsClaim": {
                    "type": "string",
                    "description": "Key used to retrieve groups from the OIDC provider",
                    "default": "groups"
                },
                "istioNamespace": {
                    "type": "string",
                    "description": "Namespace in which Istio is deployed",
                    "default": "istio-system"
                },
                "istioServiceAccountName": {
                    "type": "string",
                    "description": "Name of the Istio service account",
                    "default": "istio-ingress"
                },
                "istioGatewayName": {
                    "type": "string",
                    "description": "Name of the Istio Gateway Resource (LB operating at the edge of the mesh)",
                    "default": "ingress-gateway"
                },
                "istioVirtualServiceEnabled": {
                    "type": "boolean",
                    "description": "Enable Istio traffic routing to a named destination service",
                    "default": true
                }
            }
        },
        "configuration": {
            "type": "object",
            "properties": {
                "tokenIssuerUrl": {
                    "type": "string",
                    "description": "JWT token issuer URL",
                    "default": "{baseUrl}"
                },
                "superUserIdentifier": {
                    "type": "string",
                    "description": "Super user identification if blank all users will be super users",
                    "default": ""
                },
                "cookieParentDomain": {
                    "type": "string",
                    "description": "Cookie domain scope",
                    "default": ".telicent.localhost"
                },
                "cookieSecure": {
                    "type": "boolean",
                    "description": "Enable secure cookies",
                    "default": true
                }
            }
        },
        "externalIdp": {
            "type": "object",
            "properties": {
                "url": {
                    "type": "string",
                    "description": "External identity provider URL",
                    "default": ""
                },
                "clientName": {
                    "type": "string",
                    "description": "Identity provider display name",
                    "default": "Enterprise"
                },
                "clientId": {
                    "type": "string",
                    "description": "OAuth2 client ID",
                    "default": ""
                },
                "clientSecret": {
                    "type": "string",
                    "description": "OAuth2 client secret",
                    "default": ""
                },
                "existingSecret": {
                    "type": "string",
                    "description": "Name of an existing secret resource containing the OAuth2 client ID and secret. If specified, existing secret must contain data for EXTERNAL_IDP_CLIENT_ID and EXTERNAL_IDP_CLIENT_SECRET, and values for externalIdp.clientId and externalIdp.clientSecret will be ignored",
                    "default": ""
                }
            }
        },
        "forwardAuth": {
            "type": "object",
            "properties": {
                "secretValue": {
                    "type": "string",
                    "description": "ForwardAuth security secret",
                    "default": ""
                },
                "existingSecret": {
                    "type": "string",
                    "description": "Name of an existing secret resource containing the ForwardAuth secret value. If specified, existing secret must contain data for POSTGRES_PASSWORD, and the value for postgres.password will be ignored",
                    "default": ""
                }
            }
        },
        "postgres": {
            "type": "object",
            "properties": {
                "uri": {
                    "type": "string",
                    "description": "PostgreSQL connection URL",
                    "default": ""
                },
                "username": {
                    "type": "string",
                    "description": "PostgreSQL username",
                    "default": ""
                },
                "password": {
                    "type": "string",
                    "description": "PostgreSQL password",
                    "default": ""
                },
                "existingSecret": {
                    "type": "string",
                    "description": "Name of an existing secret resource containing the PostgreSQL password. If specified, existing secret must contain data for POSTGRES_PASSWORD, and the value for postgres.password will be ignored",
                    "default": ""
                }
            }
        },
        "fullnameOverride": {
            "type": "string",
            "description": "String to fully override the generated release name",
            "default": ""
        },
        "nameOverride": {
            "type": "string",
            "description": "String to partially override fullname (will maintain the release name)",
            "default": ""
        },
        "image": {
            "type": "object",
            "properties": {
                "registry": {
                    "type": "string",
                    "description": "Auth server image registry",
                    "default": "quay.io"
                },
                "repository": {
                    "type": "string",
                    "description": "Auth server image name",
                    "default": "telicent-auth-server"
                },
                "pullPolicy": {
                    "type": "string",
                    "description": "Auth server image pull policy",
                    "default": "IfNotPresent"
                },
                "tag": {
                    "type": "string",
                    "description": "Auth server image tag. If not set, a tag is generated using the appVersion",
                    "default": ""
                },
                "pullSecrets": {
                    "type": "array",
                    "description": "Specify registry secret names as an array",
                    "default": [],
                    "items": {}
                }
            }
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the created ServiceAccount. If not set, a name is generated using the fullname template",
                    "default": ""
                },
                "annotations": {
                    "type": "object",
                    "description": "Additional custom annotations for the ServiceAccount",
                    "default": {}
                }
            }
        },
        "podAnnotations": {
            "type": "object",
            "description": "Add extra annotations to the Deployment object",
            "default": {}
        },
        "extraEnvs": {
            "type": "array",
            "description": "List of additional environment variables to set in the pod",
            "default": [],
            "items": {}
        },
        "podSecurityContext": {
            "type": "object",
            "properties": {
                "runAsUser": {
                    "type": "number",
                    "description": "Set the provisioning pod's Security Context runAsUser User ID",
                    "default": 185
                },
                "runAsGroup": {
                    "type": "number",
                    "description": "Set the provisioning pod's Security Context runAsGroup Group ID",
                    "default": 185
                },
                "runAsNonRoot": {
                    "type": "boolean",
                    "description": "Set the provisioning pod's Security Context runAsNonRoot",
                    "default": true
                },
                "fsGroup": {
                    "type": "number",
                    "description": "Set the provisioning pod's Group ID for the mounted volumes' filesystem",
                    "default": 185
                },
                "seccompProfile": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "description": "Set the provisioning pod's Security Context seccomp profile",
                            "default": "RuntimeDefault"
                        }
                    }
                }
            }
        },
        "containerSecurityContext": {
            "type": "object",
            "properties": {
                "runAsUser": {
                    "type": "number",
                    "description": "Set containers' Security Context runAsUser User ID",
                    "default": 185
                },
                "runAsGroup": {
                    "type": "number",
                    "description": "Set containers' Security Context runAsGroup Group ID",
                    "default": 185
                },
                "runAsNonRoot": {
                    "type": "boolean",
                    "description": "Set container's Security Context runAsNonRoot",
                    "default": true
                },
                "allowPrivilegeEscalation": {
                    "type": "boolean",
                    "description": "Set container's Security Context allowPrivilegeEscalation",
                    "default": false
                },
                "capabilities": {
                    "type": "object",
                    "properties": {
                        "drop": {
                            "type": "array",
                            "description": "List of capabilities to be dropped",
                            "default": [
                                "ALL"
                            ],
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "seccompProfile": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "description": "Set container's Security Context seccomp profile",
                            "default": "RuntimeDefault"
                        }
                    }
                }
            }
        },
        "service": {
            "type": "object",
            "properties": {
                "port": {
                    "type": "number",
                    "description": "Auth server service port",
                    "default": 9000
                },
                "type": {
                    "type": "string",
                    "description": "Auth server service port",
                    "default": "ClusterIP"
                }
            }
        },
        "resources": {
            "type": "object",
            "properties": {
                "requests": {
                    "type": "object",
                    "properties": {
                        "cpu": {
                            "type": "string",
                            "description": "Set containers' CPU request",
                            "default": "500m"
                        },
                        "memory": {
                            "type": "string",
                            "description": "Set containers' memory request",
                            "default": "2000Mi"
                        }
                    }
                },
                "limits": {
                    "type": "object",
                    "properties": {
                        "cpu": {
                            "type": "string",
                            "description": "Set containers' CPU limit",
                            "default": "2000m"
                        },
                        "memory": {
                            "type": "string",
                            "description": "Set containers' memory limit",
                            "default": "4000Mi"
                        }
                    }
                }
            }
        },
        "livenessProbe": {
            "type": "object",
            "properties": {
                "httpGet": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "type": "string",
                            "description": "The path to use for the Auth server liveness probe",
                            "default": "/actuator/health"
                        },
                        "port": {
                            "type": "string",
                            "description": "The port to use for the Auth server liveness probe",
                            "default": "http"
                        }
                    }
                }
            }
        },
        "readinessProbe": {
            "type": "object",
            "properties": {
                "httpGet": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "type": "string",
                            "description": "The path to use for the Auth server liveness probe",
                            "default": "/actuator/health"
                        },
                        "port": {
                            "type": "string",
                            "description": "The port to use for the Auth server liveness probe",
                            "default": "http"
                        }
                    }
                }
            }
        },
        "nodeSelector": {
            "type": "object",
            "description": "Allows you to schedule pods on a node with a label matching the given key-value pair.",
            "default": {}
        },
        "affinity": {
            "type": "object",
            "description": "Allows you to define affinity rules for scheduling pods, see: https://kubernetes.io/docs/concepts/scheduling-eviction/assign-pod-node/",
            "default": {}
        },
        "tolerations": {
            "type": "array",
            "description": "ALlows you to schedule pods on nodes with specified taints, see: https://kubernetes.io/docs/concepts/scheduling-eviction/taint-and-toleration/",
            "default": [],
            "items": {}
        },
        "istio": {
            "type": "object",
            "properties": {
                "ingress": {
                    "type": "object",
                    "properties": {
                        "principal": {
                            "type": "string",
                            "description": "Principal used for ingress traffic to this application by the Istio AuthorizationPolicy. If not set, a principal is generated using 'global.istioNamespace' and 'global.istioServiceAccountName'",
                            "default": ""
                        }
                    }
                }
            }
        }
    }
}
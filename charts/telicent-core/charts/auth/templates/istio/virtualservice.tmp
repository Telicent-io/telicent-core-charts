{{- if .Values.global.istioVirtualServiceEnabled }}
apiVersion: networking.istio.io/v1
kind: VirtualService

metadata:
  name: {{ include "auth.fullname" . }}
  labels:
    {{- include "auth.labels" . | nindent 4 }}

spec:
  gateways:
    - {{ .Values.global.istioNamespace }}/{{ .Values.global.istioGatewayName }}
  hosts:
    - {{ .Values.global.appHostDomain }}
  http:
    - match:
        - uri:
            exact: /api/auth
      redirect:
        uri: /api/auth/
    - match:
        - uri:
            prefix: /api/auth
      rewrite:
        uriRegexRewrite:
          match: ^/api/auth(/|$)(.*)
          rewrite: /\2
      route:
        - destination:
            host: {{ include "auth.serviceName" . }}
            port:
              number: {{ .Values.service.port }}
{{- end }}
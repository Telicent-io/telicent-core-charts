{
    "title": "Chart Values",
    "type": "object",
    "properties": {
        "global": {
            "type": "object",
            "properties": {
                "imageRegistry": {
                    "type": "string",
                    "description": "Global image registry",
                    "default": ""
                },
                "imagePullSecrets": {
                    "type": "array",
                    "description": "Global registry secret names as an array",
                    "default": [],
                    "items": {}
                },
                "appHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent application services",
                    "default": "apps.telicent.io"
                },
                "authHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent authentication services, including OIDC providers",
                    "default": "auth.telicent.io"
                },
                "groupsClaim": {
                    "type": "string",
                    "description": "Key used to retrieve groups from the OIDC provider",
                    "default": "groups"
                },
                "istioNamespace": {
                    "type": "string",
                    "description": "Namespace in which Istio is deployed",
                    "default": "istio-system"
                },
                "istioServiceAccountName": {
                    "type": "string",
                    "description": "Name of the Istio service account",
                    "default": "istio-ingress"
                },
                "istioGatewayName": {
                    "type": "string",
                    "description": "Name of the Istio Gateway Resource (LB operating at the edge of the mesh)",
                    "default": "ingress-gateway"
                }
            }
        },
        "replicaCount": {
            "type": "number",
            "description": "Number of replicas for the Data Catalog deployment",
            "default": 1
        },
        "image": {
            "type": "object",
            "properties": {
                "repository": {
                    "type": "string",
                    "description": "Data Catalog image repository",
                    "default": "quay.io/telicent/telicent-data-catalog"
                },
                "pullPolicy": {
                    "type": "string",
                    "description": "Data Catalog image pull policy",
                    "default": "IfNotPresent"
                },
                "tag": {
                    "type": "string",
                    "description": "Data Catalog image tag (defaults to chart appVersion if not set)",
                    "default": ""
                }
            }
        },
        "imagePullSecrets": {
            "type": "array",
            "description": "Specify registry secret names as an array",
            "default": [],
            "items": {}
        },
        "nameOverride": {
            "type": "string",
            "description": "String to partially override the chart name",
            "default": ""
        },
        "fullnameOverride": {
            "type": "string",
            "description": "String to fully override the generated release name",
            "default": ""
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "create": {
                    "type": "boolean",
                    "description": "Specifies whether a service account should be created",
                    "default": true
                },
                "automount": {
                    "type": "boolean",
                    "description": "Automatically mount a ServiceAccount's API credentials?",
                    "default": true
                },
                "annotations": {
                    "type": "object",
                    "description": "Annotations to add to the service account",
                    "default": {}
                },
                "name": {
                    "type": "string",
                    "description": "The name of the service account to use",
                    "default": ""
                }
            }
        },
        "podAnnotations": {
            "type": "object",
            "description": "Annotations to add to the Data Catalog pods",
            "default": {}
        },
        "podLabels": {
            "type": "object",
            "description": "Labels to add to the Data Catalog pods",
            "default": {}
        },
        "podSecurityContext": {
            "type": "object",
            "description": "Security context for the Data Catalog pods",
            "default": {}
        },
        "securityContext": {
            "type": "object",
            "description": "Security context for the Data Catalog containers",
            "default": {}
        },
        "service": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "description": "The service type for the Data Catalog",
                    "default": "ClusterIP"
                },
                "port": {
                    "type": "number",
                    "description": "The service port for the Data Catalog",
                    "default": 8080
                }
            }
        },
        "resources": {
            "type": "object",
            "description": "Resource requests and limits for the Data Catalog",
            "default": {}
        },
        "livenessProbe": {
            "type": "object",
            "properties": {
                "httpGet": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "type": "string",
                            "description": "The HTTP path for the liveness probe",
                            "default": "/"
                        },
                        "port": {
                            "type": "string",
                            "description": "The HTTP port for the liveness probe",
                            "default": "http"
                        }
                    }
                }
            }
        },
        "readinessProbe": {
            "type": "object",
            "properties": {
                "httpGet": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "type": "string",
                            "description": "The HTTP path for the readiness probe",
                            "default": "/"
                        },
                        "port": {
                            "type": "string",
                            "description": "The HTTP port for the readiness probe",
                            "default": "http"
                        }
                    }
                }
            }
        },
        "volumes": {
            "type": "array",
            "description": "Additional volumes for the Data Catalog",
            "default": [],
            "items": {}
        },
        "volumeMounts": {
            "type": "array",
            "description": "Additional volume mounts for the Data Catalog",
            "default": [],
            "items": {}
        },
        "nodeSelector": {
            "type": "object",
            "description": "Node selector for the Data Catalog pods",
            "default": {}
        },
        "tolerations": {
            "type": "array",
            "description": "Tolerations for the Data Catalog pods",
            "default": [],
            "items": {}
        },
        "affinity": {
            "type": "object",
            "description": "Affinity rules for the Data Catalog pods",
            "default": {}
        },
        "istio": {
            "type": "object",
            "properties": {
                "ingress": {
                    "type": "object",
                    "properties": {
                        "principal": {
                            "type": "string",
                            "description": "Principal used for ingress traffic by the Istio AuthorizationPolicy. If not set, a principal is generated using 'global.istioNamespace' and 'global.istioServiceAccountName'",
                            "default": ""
                        }
                    }
                }
            }
        }
    }
}
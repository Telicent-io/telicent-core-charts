{
    "title": "Chart Values",
    "type": "object",
    "properties": {
        "global": {
            "type": "object",
            "properties": {
                "imageRegistry": {
                    "type": "string",
                    "description": "Global image registry",
                    "default": ""
                },
                "imagePullSecrets": {
                    "type": "array",
                    "description": "Global registry secret names as an array",
                    "default": [],
                    "items": {}
                },
                "enterprise": {
                    "type": "boolean",
                    "description": "Enable enterprise mode, adding additional features and configurations",
                    "default": false
                },
                "appHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent application/ui services",
                    "default": "apps.telicent.io"
                },
                "apiHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent Api services",
                    "default": "api.telicent.io"
                },
                "authHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent authentication services, including OIDC providers",
                    "default": "auth.telicent.io"
                },
                "groupsClaim": {
                    "type": "string",
                    "description": "Key used to retrieve groups from the OIDC provider",
                    "default": "groups"
                },
                "istioNamespace": {
                    "type": "string",
                    "description": "Namespace in which Istio is deployed",
                    "default": "istio-system"
                },
                "istioServiceAccountName": {
                    "type": "string",
                    "description": "Name of the Istio service account",
                    "default": "istio-ingress"
                },
                "istioGatewayName": {
                    "type": "string",
                    "description": "Name of the Istio Gateway Resource (LB operating at the edge of the mesh)",
                    "default": "ingress-gateway"
                },
                "istioVirtualServiceEnabled": {
                    "type": "boolean",
                    "description": "Enable Istio traffic routing to a named destination service",
                    "default": false
                }
            }
        },
        "configuration": {
            "type": "object",
            "properties": {
                "existingEnvConfigMap": {
                    "type": "string",
                    "description": "Name of existing configmap containing *Oauth2 Proxy* Environment Configuration",
                    "default": ""
                },
                "oidcIssuerUrl": {
                    "type": "string",
                    "description": "The OpenID Connect issuer URL",
                    "default": "your.host/realms/core"
                },
                "redirectUrl": {
                    "type": "string",
                    "description": "OIDC redirect URL override. If not set, 'authHostDomain' + '/oauth2/callback' will be used",
                    "default": ""
                },
                "cookieDomains": {
                    "type": "string",
                    "description": "Domains that the cookie is valid for. If not set, 'appHostDomain' will be used",
                    "default": ""
                },
                "cookieWhiteListDomains": {
                    "type": "string",
                    "description": "Allowed domains for redirection after authentication. If not set, 'apphHostDomain' will be used",
                    "default": ""
                },
                "cookieExpire": {
                    "type": "string",
                    "description": "Expire timeframe for cookie",
                    "default": "50m"
                },
                "cookieCsrfExpire": {
                    "type": "string",
                    "description": "Expire timeframe for CSRF cookie",
                    "default": "50m"
                },
                "cookieRefresh": {
                    "type": "string",
                    "description": "Refresh the cookie after this duration",
                    "default": "30m"
                }
            }
        },
        "idp": {
            "type": "object",
            "properties": {
                "issuerUrl": {
                    "type": "string",
                    "description": "The OpenID Connect issuer URL",
                    "default": ""
                },
                "jwksPath": {
                    "type": "string",
                    "description": "The path to use in combination with the issuer URL for JWKS",
                    "default": "/keys"
                },
                "existingSecret": {
                    "type": "string",
                    "description": "Name of an existing secret. The secret must contain 3 keys: 'clientid', 'clientsecret', 'cookiesecret'",
                    "default": ""
                },
                "clientId": {
                    "type": "string",
                    "description": "The OAuth Client ID",
                    "default": ""
                },
                "clientSecret": {
                    "type": "string",
                    "description": "The OAuth Client Secret",
                    "default": ""
                },
                "cookieSecret": {
                    "type": "string",
                    "description": "The seed string for secure cookies",
                    "default": ""
                }
            }
        },
        "tls": {
            "type": "object",
            "properties": {
                "ca": {
                    "type": "object",
                    "properties": {
                        "existingSecret": {
                            "type": "string",
                            "description": "Name of an existing secret that contains CA certificate(s). The secret must contains 1 key: 'ca.crt' containing the CA certificate(s)",
                            "default": ""
                        },
                        "existingConfigMap": {
                            "type": "string",
                            "description": "Name of an existing configmap that contains CA certificate(s). The configmap must contains 1 key: 'ca.crt' containing the CA certificate(s)",
                            "default": ""
                        },
                        "certificate": {
                            "type": "string",
                            "description": "The PEM-encoded certificate(s) of the CA (certificate authority)",
                            "default": ""
                        }
                    }
                }
            }
        },
        "nameOverride": {
            "type": "string",
            "description": "String to partially override fullname (will maintain the release name)",
            "default": ""
        },
        "fullnameOverride": {
            "type": "string",
            "description": "String to fully override the generated release name",
            "default": ""
        },
        "namespaceOverride": {
            "type": "string",
            "description": "String to fully override all deployed resources namespace",
            "default": ""
        },
        "commonLabels": {
            "type": "object",
            "description": "Add labels to all the deployed resources",
            "default": {}
        },
        "replicas": {
            "type": "number",
            "description": "Number of *Ouath2 Proxy* replicas to deploy",
            "default": 1
        },
        "revisionHistoryLimit": {
            "type": "number",
            "description": "Number of controller revisions to keep",
            "default": 5
        },
        "annotations": {
            "type": "object",
            "description": "Add extra annotations to the Deployment Object",
            "default": {}
        },
        "podLabels": {
            "type": "object",
            "description": "Add extra labels to the *Oauth2 Proxy* pod",
            "default": {}
        },
        "podAnnotations": {
            "type": "object",
            "description": "Add extra annotations to the *Oauth2 Proxy* pod",
            "default": {}
        },
        "extraEnvVars": {
            "type": "array",
            "description": "Array with extra environment variables to add to *Oauth2 Proxy* pod",
            "default": [],
            "items": {}
        },
        "extraVolumes": {
            "type": "array",
            "description": "Additional containers to be added to the *Auth* pod",
            "default": [],
            "items": {}
        },
        "extraVolumeMounts": {
            "type": "array",
            "description": "Optionally specify extra list of additional volumeMounts",
            "default": [],
            "items": {}
        },
        "initContainers": {
            "type": "array",
            "description": "Add init containers to the pod",
            "default": [],
            "items": {}
        },
        "sidecars": {
            "type": "array",
            "description": "Add sidecars to the pod.",
            "default": [],
            "items": {}
        },
        "image": {
            "type": "object",
            "properties": {
                "registry": {
                    "type": "string",
                    "description": "*Oauth2 Proxy* image registry",
                    "default": "REGISTRY_NAME"
                },
                "repository": {
                    "type": "string",
                    "description": "*Oauth2 Proxy* image name",
                    "default": "REPOSITORY_NAME/oauth2-proxy"
                },
                "tag": {
                    "type": "string",
                    "description": "*Oauth2 Proxy* image tag. If not set, a tag is generated using the appVersion",
                    "default": ""
                },
                "pullPolicy": {
                    "type": "string",
                    "description": "*Oauth2 Proxy* image pull policy",
                    "default": "IfNotPresent"
                },
                "pullSecrets": {
                    "type": "array",
                    "description": "Specify registry secret names as an array",
                    "default": [],
                    "items": {}
                }
            }
        },
        "resources": {
            "type": "object",
            "properties": {
                "requests": {
                    "type": "object",
                    "properties": {
                        "cpu": {
                            "type": "string",
                            "description": "Set containers' CPU request",
                            "default": "300m"
                        },
                        "memory": {
                            "type": "string",
                            "description": "Set containers' memory request",
                            "default": "512Mi"
                        }
                    }
                },
                "limits": {
                    "type": "object",
                    "properties": {
                        "cpu": {
                            "type": "string",
                            "description": "Set containers' CPU limit",
                            "default": "500m"
                        },
                        "memory": {
                            "type": "string",
                            "description": "Set containers' memory limit",
                            "default": "800Mi"
                        }
                    }
                }
            }
        },
        "containerSecurityContext": {
            "type": "object",
            "properties": {
                "runAsUser": {
                    "type": "number",
                    "description": "Set containers' Security Context runAsUser User ID",
                    "default": 185
                },
                "runAsGroup": {
                    "type": "number",
                    "description": "Set containers' Security Context runAsGroup Group ID",
                    "default": 185
                },
                "runAsNonRoot": {
                    "type": "boolean",
                    "description": "Set container's Security Context runAsNonRoot",
                    "default": true
                },
                "allowPrivilegeEscalation": {
                    "type": "boolean",
                    "description": "Set container's Security Context allowPrivilegeEscalation",
                    "default": false
                },
                "capabilities": {
                    "type": "object",
                    "properties": {
                        "drop": {
                            "type": "array",
                            "description": "List of capabilities to be dropped",
                            "default": [
                                "ALL"
                            ],
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "seccompProfile": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "description": "Set container's Security Context seccomp profile",
                            "default": "RuntimeDefault"
                        }
                    }
                }
            }
        },
        "podSecurityContext": {
            "type": "object",
            "properties": {
                "runAsUser": {
                    "type": "number",
                    "description": "Set the provisioning pod's Security Context runAsUser User ID",
                    "default": 185
                },
                "runAsGroup": {
                    "type": "number",
                    "description": "Set the provisioning pod's Security Context runAsGroup Group ID",
                    "default": 185
                },
                "runAsNonRoot": {
                    "type": "boolean",
                    "description": "Set the provisioning pod's Security Context runAsNonRoot",
                    "default": true
                },
                "fsGroup": {
                    "type": "number",
                    "description": "Set the provisioning pod's Group ID for the mounted volumes' filesystem",
                    "default": 185
                },
                "seccompProfile": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "description": "Set the provisioning pod's Security Context seccomp profile",
                            "default": "RuntimeDefault"
                        }
                    }
                }
            }
        },
        "affinity": {
            "type": "object",
            "description": "Affinity for pod assignment",
            "default": {}
        },
        "nodeSelector": {
            "type": "object",
            "description": "Node labels for pod assignment",
            "default": {}
        },
        "tolerations": {
            "type": "array",
            "description": "Tolerations for pod assignment",
            "default": [],
            "items": {}
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "create": {
                    "type": "boolean",
                    "description": "Specifies whether a service account should be created",
                    "default": true
                },
                "name": {
                    "type": "string",
                    "description": "Name of the ServiceAccount to use. If not set, a name is generated using the fullname",
                    "default": "oauth2-proxy"
                },
                "annotations": {
                    "type": "object",
                    "description": "Additional custom annotations for the ServiceAccount",
                    "default": {}
                },
                "automount": {
                    "type": "boolean",
                    "description": "Automatically mount a ServiceAccount's API credentials",
                    "default": true
                }
            }
        },
        "service": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "*Oauth2 Proxy* service name. If not set, a name is generated using the fullname",
                    "default": "oauth2-proxy"
                },
                "port": {
                    "type": "number",
                    "description": "*Oauth2 Proxy* service port",
                    "default": 4080
                },
                "type": {
                    "type": "string",
                    "description": "*Oauth2 Proxy* service type",
                    "default": "ClusterIP"
                }
            }
        },
        "istio": {
            "type": "object",
            "properties": {
                "ingress": {
                    "type": "object",
                    "properties": {
                        "principal": {
                            "type": "string",
                            "description": "Principal used for ingress traffic by the Istio AuthorizationPolicy. If not set, a principal is generated using Release namespace and serviceAccountName",
                            "default": ""
                        },
                        "serviceAccountName": {
                            "type": "string",
                            "description": "Name of the Ingress service account (traefik and istio supported)",
                            "default": "traefik-proxy"
                        }
                    }
                },
                "virtualService": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Enable Istio traffic into *Oauth2 Proxy*",
                            "default": false
                        },
                        "host": {
                            "type": "string",
                            "description": "Host associated with *Oauth2 Proxy* If not set, 'appHostDomain' will be used",
                            "default": ""
                        }
                    }
                }
            }
        }
    }
}
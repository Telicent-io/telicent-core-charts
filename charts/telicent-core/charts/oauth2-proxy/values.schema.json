{
    "title": "Chart Values",
    "type": "object",
    "properties": {
        "global": {
            "type": "object",
            "properties": {
                "imageRegistry": {
                    "type": "string",
                    "description": "Global image registry",
                    "default": ""
                },
                "imagePullSecrets": {
                    "type": "array",
                    "description": "Global registry secret names as an array",
                    "default": [],
                    "items": {}
                },
                "appHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent application services",
                    "default": "apps.telicent.io"
                },
                "authHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent authentication services, including OIDC providers",
                    "default": "auth.telicent.io"
                },
                "groupsClaim": {
                    "type": "string",
                    "description": "Key used to retrieve groups from the OIDC provider",
                    "default": "groups"
                },
                "istioNamespace": {
                    "type": "string",
                    "description": "Namespace in which Istio is deployed",
                    "default": "istio-system"
                },
                "istioServiceAccountName": {
                    "type": "string",
                    "description": "Name of the Istio service account",
                    "default": "istio-ingress"
                },
                "istioGatewayName": {
                    "type": "string",
                    "description": "Name of the Istio Gateway Resource (LB operating at the edge of the mesh)",
                    "default": "ingress-gateway"
                },
                "istioVirtualServiceEnabled": {
                    "type": "boolean",
                    "description": "Enable Istio traffic routing to a named destination service",
                    "default": true
                }
            }
        },
        "replicaCount": {
            "type": "number",
            "description": "Number of pod replicas to deploy",
            "default": 1
        },
        "existingEnvConfigmapName": {
            "type": "string",
            "description": "Name of an existing ConfigMap for environment variables",
            "default": ""
        },
        "existingCacertConfigmapName": {
            "type": "string",
            "description": "Name of an existing ConfigMap for CA certificates",
            "default": ""
        },
        "existingCacertSecretName": {
            "type": "string",
            "description": "Name of the secret containing the CA certificates",
            "default": ""
        },
        "existingEnvSecretName": {
            "type": "string",
            "description": "Name of an existing Secret for environment variables",
            "default": ""
        },
        "image": {
            "type": "object",
            "properties": {
                "repository": {
                    "type": "string",
                    "description": "Container image repository",
                    "default": "quay.io/oauth2-proxy/oauth2-proxy"
                },
                "pullPolicy": {
                    "type": "string",
                    "description": "Image pull policy",
                    "default": "IfNotPresent"
                },
                "tag": {
                    "type": "string",
                    "description": "Image tag (defaults to chart appVersion if not set)",
                    "default": "v7.12.0"
                }
            }
        },
        "configuration": {
            "type": "object",
            "properties": {
                "cookieDomain": {
                    "type": "string",
                    "description": "Domain that the cookie is valid for",
                    "default": "127.0.0.1.nip.io"
                },
                "cookieExpire": {
                    "type": "string",
                    "description": "Cookie expiration duration",
                    "default": "15m"
                },
                "cookieRefresh": {
                    "type": "string",
                    "description": "Cookie refresh duration",
                    "default": "10m"
                },
                "cookieSecret": {
                    "type": "string",
                    "description": "Cookie secret (should be set via existingEnvSecretName) defaults to a random value if not set",
                    "default": ""
                },
                "oidcIssuerUrl": {
                    "type": "string",
                    "description": "OIDC issuer URL",
                    "default": "https://127.0.0.1.nip.io/realms/core"
                },
                "redirectUrlOverride": {
                    "type": "string",
                    "description": "OIDC redirect URL override (if not set, appHostDomain + /oauth2/callback will be used)",
                    "default": ""
                },
                "oidcClientID": {
                    "type": "string",
                    "description": "OIDC client ID",
                    "default": "change-me"
                },
                "clientSecret": {
                    "type": "string",
                    "description": "OIDC client secret (should be set via existingEnvSecretName)",
                    "default": "change-me"
                },
                "cacert": {
                    "type": "string",
                    "description": "Optional CA certificate data (PEM format) for validating the OIDC provider's TLS certificate",
                    "default": ""
                }
            }
        },
        "imagePullSecrets": {
            "type": "array",
            "description": "Registry secret names as an array for private image repositories",
            "default": [],
            "items": {}
        },
        "nameOverride": {
            "type": "string",
            "description": "String to partially override the chart name",
            "default": ""
        },
        "fullnameOverride": {
            "type": "string",
            "description": "String to fully override the generated release name",
            "default": ""
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "create": {
                    "type": "boolean",
                    "description": "Specifies whether a service account should be created",
                    "default": true
                },
                "automount": {
                    "type": "boolean",
                    "description": "Automatically mount a ServiceAccount's API credentials",
                    "default": true
                },
                "annotations": {
                    "type": "object",
                    "description": "Annotations to add to the service account",
                    "default": {}
                },
                "name": {
                    "type": "string",
                    "description": "The name of the service account to use",
                    "default": ""
                }
            }
        },
        "podAnnotations": {
            "type": "object",
            "description": "Annotations to add to the pod",
            "default": {}
        },
        "podLabels": {
            "type": "object",
            "description": "Labels to add to the pod",
            "default": {}
        },
        "podSecurityContext": {
            "type": "object",
            "description": "Pod-level security context",
            "default": {}
        },
        "securityContext": {
            "type": "object",
            "description": "Container-level security context",
            "default": {}
        },
        "service": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "description": "Service type (ClusterIP, NodePort, LoadBalancer)",
                    "default": "ClusterIP"
                },
                "port": {
                    "type": "number",
                    "description": "Service port",
                    "default": 4080
                }
            }
        },
        "resources": {
            "type": "object",
            "description": "Resource requests and limits for the container",
            "default": {}
        },
        "volumes": {
            "type": "array",
            "description": "Additional volumes to be added to the pod",
            "default": [],
            "items": {}
        },
        "volumeMounts": {
            "type": "array",
            "description": "Additional volume mounts to be added to the container",
            "default": [],
            "items": {}
        },
        "nodeSelector": {
            "type": "object",
            "description": "Node selector for pod scheduling",
            "default": {}
        },
        "tolerations": {
            "type": "array",
            "description": "Tolerations for pod scheduling",
            "default": [],
            "items": {}
        },
        "affinity": {
            "type": "object",
            "description": "Affinity rules for pod scheduling",
            "default": {}
        },
        "extraContainers": {
            "type": "array",
            "description": "Additional containers to be added to the pod",
            "default": [],
            "items": {}
        },
        "istio": {
            "type": "object",
            "properties": {
                "ingress": {
                    "type": "object",
                    "properties": {
                        "principal": {
                            "type": "string",
                            "description": "Principal used for ingress traffic by the Istio AuthorizationPolicy. If not set, a principal is generated using 'global.istioNamespace' and 'global.istioServiceAccountName'",
                            "default": ""
                        }
                    }
                }
            }
        }
    }
}
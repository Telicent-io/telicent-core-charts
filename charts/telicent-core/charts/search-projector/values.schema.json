{
    "title": "Chart Values",
    "type": "object",
    "properties": {
        "global": {
            "type": "object",
            "properties": {
                "imageRegistry": {
                    "type": "string",
                    "description": "Global image registry",
                    "default": ""
                },
                "imagePullSecrets": {
                    "type": "array",
                    "description": "Global registry secret names as an array",
                    "default": [],
                    "items": {}
                },
                "kafka": {
                    "type": "object",
                    "properties": {
                        "bootstrapServers": {
                            "type": "string",
                            "description": "Comma separated list containing Kafka bootstrap servers",
                            "default": "kafka-bootstrap.kafka.svc.cluster.local:9092"
                        },
                        "existingConfigSecretName": {
                            "type": "string",
                            "description": "Name of an existing secret containing Kafka configuration",
                            "default": ""
                        },
                        "username": {
                            "type": "string",
                            "description": "Username for Kafka authentication",
                            "default": "your.kafka.username.here"
                        },
                        "password": {
                            "type": "string",
                            "description": "Password for Kafka authentication",
                            "default": "your.kafka.password.here"
                        },
                        "protocol": {
                            "type": "string",
                            "description": "Protocol used for Kafka communication",
                            "default": "SASL_SSL"
                        },
                        "mechanism": {
                            "type": "string",
                            "description": "SASL mechanism used for Kafka authentication",
                            "default": "SCRAM-SHA-512"
                        }
                    }
                },
                "truststore": {
                    "type": "object",
                    "properties": {
                        "existingSecretName": {
                            "type": "string",
                            "description": "Name of an existing secret containing the truststore",
                            "default": ""
                        },
                        "mountPath": {
                            "type": "string",
                            "description": "The mount path for the truststore in the container",
                            "default": "/app/config/truststore"
                        }
                    }
                }
            }
        },
        "configMap": {
            "type": "object",
            "properties": {
                "existingEnvConfigMap": {
                    "type": "string",
                    "description": "Name of existing configmap containing *Search Projector* Environment Configuration",
                    "default": ""
                }
            }
        },
        "java": {
            "type": "object",
            "properties": {
                "jvmOptions": {
                    "type": "string",
                    "description": "JVM options for the application",
                    "default": "-XX:MaxRAMPercentage=80.0"
                }
            }
        },
        "elastic": {
            "type": "object",
            "properties": {
                "host": {
                    "type": "string",
                    "description": "Elastic/OpenSearch host",
                    "default": "https://your.opensearch.host"
                },
                "port": {
                    "type": "string",
                    "description": "Elastic/OpenSearch cluster port",
                    "default": "443"
                },
                "opensearchCompatibility": {
                    "type": "boolean",
                    "description": "Enable OpenSearch compatibility",
                    "default": true
                },
                "indexName": {
                    "type": "string",
                    "description": "Elastic/OpenSearch index name",
                    "default": "search"
                },
                "topic": {
                    "type": "string",
                    "description": "Topic to consume messages from",
                    "default": "knowledge"
                },
                "dlqTopic": {
                    "type": "string",
                    "description": "Dead-letter topic for failed messages",
                    "default": "knowledge.dlq"
                },
                "indexBatchSize": {
                    "type": "string",
                    "description": "Number of documents to index in a single batch operation",
                    "default": "500"
                },
                "existingSecret": {
                    "type": "string",
                    "description": "Name of an existing secret. The secret must contain 2 keys: 'username', 'password'",
                    "default": ""
                },
                "username": {
                    "type": "string",
                    "description": "OpenSearch/Elastic username",
                    "default": ""
                },
                "password": {
                    "type": "string",
                    "description": "OpenSearch/Elastic user password",
                    "default": ""
                }
            }
        },
        "nameOverride": {
            "type": "string",
            "description": "String to partially override fullname (will maintain the release name)",
            "default": ""
        },
        "fullnameOverride": {
            "type": "string",
            "description": "String to fully override the generated release name",
            "default": ""
        },
        "namespaceOverride": {
            "type": "string",
            "description": "String to fully override all deployed resources namespace",
            "default": ""
        },
        "commonLabels": {
            "type": "object",
            "description": "Add labels to all the deployed resources",
            "default": {}
        },
        "replicas": {
            "type": "number",
            "description": "Number of *Search Projector* replicas to deploy",
            "default": 1
        },
        "revisionHistoryLimit": {
            "type": "number",
            "description": "Number of controller revisions to keep",
            "default": 5
        },
        "annotations": {
            "type": "object",
            "description": "Add extra annotations to the deployment object",
            "default": {}
        },
        "podLabels": {
            "type": "object",
            "description": "Add extra labels to the *Search Projector* pod",
            "default": {}
        },
        "podAnnotations": {
            "type": "object",
            "description": "Add extra annotations to the *Search Projector* pod",
            "default": {}
        },
        "extraEnvVars": {
            "type": "array",
            "description": "Array with extra environment variables to add to *Search Projector* pod",
            "default": [],
            "items": {}
        },
        "extraVolumes": {
            "type": "array",
            "description": "Additional containers to be added to the *Search Projector* pod",
            "default": [],
            "items": {}
        },
        "extraVolumeMounts": {
            "type": "array",
            "description": "Optionally specify extra list of additional volumeMounts",
            "default": [],
            "items": {}
        },
        "initContainers": {
            "type": "array",
            "description": "Add init containers to the pod",
            "default": [],
            "items": {}
        },
        "sidecars": {
            "type": "array",
            "description": "Add sidecars to the pod.",
            "default": [],
            "items": {}
        },
        "image": {
            "type": "object",
            "properties": {
                "registry": {
                    "type": "string",
                    "description": "*Search Projector* image registry",
                    "default": "REGISTRY_NAME"
                },
                "repository": {
                    "type": "string",
                    "description": "*Search Projector* image name",
                    "default": "REPOSITORY_NAME/smart-cache-elastic-index"
                },
                "tag": {
                    "type": "string",
                    "description": "*Search Projector* image tag. If not set, a tag is generated using the appVersion",
                    "default": ""
                },
                "pullPolicy": {
                    "type": "string",
                    "description": "*Search Projector* image pull policy",
                    "default": "IfNotPresent"
                },
                "pullSecrets": {
                    "type": "array",
                    "description": "Specify registry secret names as an array",
                    "default": [],
                    "items": {}
                }
            }
        },
        "resources": {
            "type": "object",
            "properties": {
                "requests": {
                    "type": "object",
                    "properties": {
                        "cpu": {
                            "type": "string",
                            "description": "Set containers' CPU request",
                            "default": "250m"
                        },
                        "memory": {
                            "type": "string",
                            "description": "Set containers' memory request",
                            "default": "1000Mi"
                        }
                    }
                },
                "limits": {
                    "type": "object",
                    "properties": {
                        "cpu": {
                            "type": "string",
                            "description": "Set containers' CPU limit",
                            "default": "500m"
                        },
                        "memory": {
                            "type": "string",
                            "description": "Set containers' memory limit",
                            "default": "2000Mi"
                        }
                    }
                }
            }
        },
        "containerSecurityContext": {
            "type": "object",
            "properties": {
                "runAsUser": {
                    "type": "number",
                    "description": "Set containers' Security Context runAsUser User ID",
                    "default": 185
                },
                "runAsGroup": {
                    "type": "number",
                    "description": "Set containers' Security Context runAsGroup Group ID",
                    "default": 185
                },
                "runAsNonRoot": {
                    "type": "boolean",
                    "description": "Set container's Security Context runAsNonRoot",
                    "default": true
                },
                "allowPrivilegeEscalation": {
                    "type": "boolean",
                    "description": "Set container's Security Context allowPrivilegeEscalation",
                    "default": false
                },
                "capabilities": {
                    "type": "object",
                    "properties": {
                        "drop": {
                            "type": "array",
                            "description": "List of capabilities to be dropped",
                            "default": [
                                "ALL"
                            ],
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "seccompProfile": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "description": "Set container's Security Context seccomp profile",
                            "default": "RuntimeDefault"
                        }
                    }
                }
            }
        },
        "podSecurityContext": {
            "type": "object",
            "properties": {
                "runAsUser": {
                    "type": "number",
                    "description": "Set the provisioning pod's Security Context runAsUser User ID",
                    "default": 185
                },
                "runAsGroup": {
                    "type": "number",
                    "description": "Set the provisioning pod's Security Context runAsGroup Group ID",
                    "default": 185
                },
                "runAsNonRoot": {
                    "type": "boolean",
                    "description": "Set the provisioning pod's Security Context runAsNonRoot",
                    "default": true
                },
                "fsGroup": {
                    "type": "number",
                    "description": "Set the provisioning pod's Group ID for the mounted volumes' filesystem",
                    "default": 185
                },
                "seccompProfile": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "description": "Set the provisioning pod's Security Context seccomp profile",
                            "default": "RuntimeDefault"
                        }
                    }
                }
            }
        },
        "affinity": {
            "type": "object",
            "description": "Affinity for pod assignment",
            "default": {}
        },
        "nodeSelector": {
            "type": "object",
            "description": "Node labels for pod assignment",
            "default": {}
        },
        "tolerations": {
            "type": "array",
            "description": "Tolerations for pod assignment",
            "default": [],
            "items": {}
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "create": {
                    "type": "boolean",
                    "description": "Specifies whether a service account should be created",
                    "default": true
                },
                "name": {
                    "type": "string",
                    "description": "Name of the ServiceAccount to use. If not set, a name is generated using the fullname",
                    "default": ""
                },
                "annotations": {
                    "type": "object",
                    "description": "Additional custom annotations for the ServiceAccount",
                    "default": {}
                },
                "automount": {
                    "type": "boolean",
                    "description": "Automatically mount a ServiceAccount's API credentials",
                    "default": true
                }
            }
        },
        "service": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "*Search Projector* service name. If not set, a name is generated using the fullname",
                    "default": ""
                },
                "type": {
                    "type": "string",
                    "description": "*Search Projector* service type",
                    "default": "ClusterIP"
                }
            }
        },
        "metrics": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Enable Prometheus metrics",
                    "default": true
                },
                "service": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string",
                            "description": "Name for the Prometheus service",
                            "default": "metrics"
                        },
                        "port": {
                            "type": "number",
                            "description": "Port for the Prometheus service",
                            "default": 9464
                        }
                    }
                }
            }
        }
    }
}
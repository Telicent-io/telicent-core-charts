{
    "title": "Chart Values",
    "type": "object",
    "properties": {
        "global": {
            "type": "object",
            "properties": {
                "enterprise": {
                    "type": "boolean",
                    "description": "Enable enterprise mode, adding additional features and configurations",
                    "default": false
                },
                "appHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent application/ui services",
                    "default": "apps.telicent.io"
                },
                "apiHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent Api services",
                    "default": "api.telicent.io"
                },
                "authHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent authentication services, including OIDC providers",
                    "default": "auth.telicent.io"
                },
                "releaseNameTelicentPreview": {
                    "type": "string",
                    "description": "Release name used during the Telicent Preview chart installation. Note: ensure the value is correct, otherwise there will be no access to data-catalog, user-portal & paperback-writer",
                    "default": ""
                },
                "istioNamespace": {
                    "type": "string",
                    "description": "Namespace in which Istio is deployed",
                    "default": "istio-system"
                },
                "istioServiceAccountName": {
                    "type": "string",
                    "description": "Name of the Istio service account",
                    "default": "istio-ingress"
                },
                "istioGatewayName": {
                    "type": "string",
                    "description": "Name of the Istio Gateway Resource (LB operating at the edge of the mesh)",
                    "default": "ingress-gateway"
                }
            }
        },
        "rateLimit": {
            "type": "object",
            "properties": {
                "app": {
                    "type": "object",
                    "properties": {
                        "average": {
                            "type": "number",
                            "description": "Maximum number of requests per second allowed to the Web Applications (0 means no rate limiting).",
                            "default": 0
                        },
                        "burst": {
                            "type": "number",
                            "description": "Maximum number of requests allowed to go through at the very same moment to the Web Applications.",
                            "default": 100
                        }
                    }
                },
                "api": {
                    "type": "object",
                    "properties": {
                        "average": {
                            "type": "number",
                            "description": "Maximum number of requests per second allowed to the API Services (0 means no rate limiting).",
                            "default": 100
                        },
                        "burst": {
                            "type": "number",
                            "description": "Maximum number of requests allowed to go through at the very same moment to the API Services.",
                            "default": 25
                        }
                    }
                },
                "auth": {
                    "type": "object",
                    "properties": {
                        "average": {
                            "type": "number",
                            "description": "Maximum number of requests per second allowed to the Authentication Service (0 means no rate limiting).",
                            "default": 20
                        },
                        "burst": {
                            "type": "number",
                            "description": "Maximum number of requests allowed to go through at the very same moment to the Authentication Service.",
                            "default": 10
                        }
                    }
                }
            }
        },
        "cors": {
            "type": "object",
            "properties": {
                "extraHosts": {
                    "type": "array",
                    "description": "Additional hosts to be added to the 'AllowOriginList'",
                    "default": [],
                    "items": {}
                }
            }
        },
        "forwardAuth": {
            "type": "object",
            "properties": {
                "existingSecret": {
                    "type": "string",
                    "description": "Name of an existing secret. The secret must contain 1 key: 'secret'",
                    "default": ""
                },
                "header": {
                    "type": "string",
                    "description": "The secret value to be associated with the `X-ForwardAuth-Secret`.",
                    "default": ""
                }
            }
        },
        "logs": {
            "type": "object",
            "properties": {
                "general": {
                    "type": "object",
                    "properties": {
                        "level": {
                            "type": "string",
                            "description": "Set logging levels, values are: TRACE, DEBUG, INFO, WARN, ERROR, FATAL, and PANIC.",
                            "default": "INFO"
                        }
                    }
                },
                "access": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Enable access logging. Note: should only be enabled in development environments.",
                            "default": false
                        }
                    }
                }
            }
        },
        "dashboard": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Enable *Traefik Proxy* dashboard. Note: should only be enabled in development environments.",
                    "default": false
                },
                "domain": {
                    "type": "string",
                    "description": "Domain associated with *Traefik Proxy* dashboard. If not set, 'appHostDomain' will be used",
                    "default": ""
                },
                "basepath": {
                    "type": "string",
                    "description": "Set the base path to be used for accessing the dashboard",
                    "default": "/traefik"
                }
            }
        },
        "nameOverride": {
            "type": "string",
            "description": "String to partially override fullname (will maintain the release name)",
            "default": ""
        },
        "fullnameOverride": {
            "type": "string",
            "description": "String to fully override the generated release name",
            "default": ""
        },
        "namespaceOverride": {
            "type": "string",
            "description": "String to fully override all deployed resources namespace",
            "default": ""
        },
        "commonLabels": {
            "type": "object",
            "description": "Add labels to all the deployed resources",
            "default": {}
        },
        "replicas": {
            "type": "number",
            "description": "Number of *Traefik Proxy* replicas to deploy",
            "default": 1
        },
        "revisionHistoryLimit": {
            "type": "number",
            "description": "Number of controller revisions to keep",
            "default": 5
        },
        "annotations": {
            "type": "object",
            "description": "Add extra annotations to the deployment object",
            "default": {}
        },
        "podLabels": {
            "type": "object",
            "description": "Add extra labels to the *Traefik Proxy* pod",
            "default": {}
        },
        "podAnnotations": {
            "type": "object",
            "description": "Add extra annotations to the *Traefik Proxy* pod",
            "default": {}
        },
        "extraEnvVars": {
            "type": "array",
            "description": "Array with extra environment variables to add to *Traefik Proxy* pod",
            "default": [],
            "items": {}
        },
        "extraVolumes": {
            "type": "array",
            "description": "Additional containers to be added to the *Traefik Proxy* pod",
            "default": [],
            "items": {}
        },
        "extraVolumeMounts": {
            "type": "array",
            "description": "Optionally specify extra list of additional volumeMounts",
            "default": [],
            "items": {}
        },
        "initContainers": {
            "type": "array",
            "description": "Add init containers to the pod",
            "default": [],
            "items": {}
        },
        "sidecars": {
            "type": "array",
            "description": "Add sidecars to the pod.",
            "default": [],
            "items": {}
        },
        "image": {
            "type": "object",
            "properties": {
                "registry": {
                    "type": "string",
                    "description": "*Traefik Proxy* image registry",
                    "default": "REGISTRY_NAME"
                },
                "repository": {
                    "type": "string",
                    "description": "*Traefik Proxy* image name",
                    "default": "REPOSITORY_NAME/traefik"
                },
                "tag": {
                    "type": "string",
                    "description": "*Traefik Proxy* image tag. If not set, a tag is generated using the appVersion",
                    "default": ""
                },
                "pullPolicy": {
                    "type": "string",
                    "description": "*Traefik Proxy* image pull policy",
                    "default": "IfNotPresent"
                },
                "pullSecrets": {
                    "type": "array",
                    "description": "Specify registry secret names as an array",
                    "default": [],
                    "items": {}
                }
            }
        },
        "resources": {
            "type": "object",
            "properties": {
                "requests": {
                    "type": "object",
                    "properties": {
                        "cpu": {
                            "type": "string",
                            "description": "Set containers' CPU request",
                            "default": "500m"
                        },
                        "memory": {
                            "type": "string",
                            "description": "Set containers' memory request",
                            "default": "512Mi"
                        }
                    }
                },
                "limits": {
                    "type": "object",
                    "properties": {
                        "cpu": {
                            "type": "string",
                            "description": "Set containers' CPU limit",
                            "default": "750m"
                        },
                        "memory": {
                            "type": "string",
                            "description": "Set containers' memory limit",
                            "default": "768Mi"
                        }
                    }
                }
            }
        },
        "containerSecurityContext": {
            "type": "object",
            "properties": {
                "runAsUser": {
                    "type": "number",
                    "description": "Set containers' Security Context runAsUser User ID",
                    "default": 185
                },
                "runAsGroup": {
                    "type": "number",
                    "description": "Set containers' Security Context runAsGroup Group ID",
                    "default": 185
                },
                "runAsNonRoot": {
                    "type": "boolean",
                    "description": "Set container's Security Context runAsNonRoot",
                    "default": true
                },
                "allowPrivilegeEscalation": {
                    "type": "boolean",
                    "description": "Set container's Security Context allowPrivilegeEscalation",
                    "default": false
                },
                "capabilities": {
                    "type": "object",
                    "properties": {
                        "drop": {
                            "type": "array",
                            "description": "List of capabilities to be dropped",
                            "default": [
                                "ALL"
                            ],
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "seccompProfile": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "description": "Set container's Security Context seccomp profile",
                            "default": "RuntimeDefault"
                        }
                    }
                }
            }
        },
        "podSecurityContext": {
            "type": "object",
            "properties": {
                "runAsUser": {
                    "type": "number",
                    "description": "Set the provisioning pod's Security Context runAsUser User ID",
                    "default": 185
                },
                "runAsGroup": {
                    "type": "number",
                    "description": "Set the provisioning pod's Security Context runAsGroup Group ID",
                    "default": 185
                },
                "runAsNonRoot": {
                    "type": "boolean",
                    "description": "Set the provisioning pod's Security Context runAsNonRoot",
                    "default": true
                },
                "fsGroup": {
                    "type": "number",
                    "description": "Set the provisioning pod's Group ID for the mounted volumes' filesystem",
                    "default": 185
                },
                "seccompProfile": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "description": "Set the provisioning pod's Security Context seccomp profile",
                            "default": "RuntimeDefault"
                        }
                    }
                }
            }
        },
        "affinity": {
            "type": "object",
            "description": "Affinity for pod assignment",
            "default": {}
        },
        "nodeSelector": {
            "type": "object",
            "description": "Node labels for pod assignment",
            "default": {}
        },
        "tolerations": {
            "type": "array",
            "description": "Tolerations for pod assignment",
            "default": [],
            "items": {}
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "create": {
                    "type": "boolean",
                    "description": "Specifies whether a service account should be created",
                    "default": true
                },
                "name": {
                    "type": "string",
                    "description": "Name of the ServiceAccount to use. If not set, a name is generated using the fullname",
                    "default": ""
                },
                "annotations": {
                    "type": "object",
                    "description": "Additional custom annotations for the ServiceAccount",
                    "default": {}
                },
                "automount": {
                    "type": "boolean",
                    "description": "Automatically mount a ServiceAccount's API credentials",
                    "default": true
                }
            }
        },
        "service": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "*Traefik Proxy* service name. If not set, a name is generated using the fullname",
                    "default": ""
                },
                "app": {
                    "type": "object",
                    "properties": {
                        "port": {
                            "type": "number",
                            "description": "*Traefik Proxy* APP/UI service port",
                            "default": 8080
                        },
                        "type": {
                            "type": "string",
                            "description": "*Traefik Proxy* APP/UI service type",
                            "default": "ClusterIP"
                        }
                    }
                },
                "api": {
                    "type": "object",
                    "properties": {
                        "port": {
                            "type": "number",
                            "description": "*Traefik Proxy* API service port",
                            "default": 8081
                        },
                        "type": {
                            "type": "string",
                            "description": "*Traefik Proxy* API service type",
                            "default": "ClusterIP"
                        }
                    }
                },
                "auth": {
                    "type": "object",
                    "properties": {
                        "port": {
                            "type": "number",
                            "description": "*Traefik Proxy* AUTH service port",
                            "default": 8082
                        },
                        "type": {
                            "type": "string",
                            "description": "*Traefik Proxy* AUTH service type",
                            "default": "ClusterIP"
                        }
                    }
                }
            }
        },
        "istio": {
            "type": "object",
            "properties": {
                "virtualService": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Enable Istio traffic into *Traefik Proxy*",
                            "default": true
                        },
                        "extraHosts": {
                            "type": "array",
                            "description": "Additional hosts (excluding appHostDomain) to be managed by *Traefik Proxy*",
                            "default": [],
                            "items": {}
                        }
                    }
                },
                "ingress": {
                    "type": "object",
                    "properties": {
                        "principal": {
                            "type": "string",
                            "description": "Principal used for ingress traffic by the Istio AuthorizationPolicy. If not set, a principal is generated using Release namespace and serviceAccountName",
                            "default": "cluster.local/ns/istio-system/sa/istio-ingress"
                        },
                        "serviceAccountName": {
                            "type": "string",
                            "description": "Name of the Ingress service account (istio currently supported)",
                            "default": "istio-ingress"
                        }
                    }
                }
            }
        },
        "hosts": {
            "type": "object",
            "properties": {
                "enableAutoCorrect": {
                    "type": "boolean",
                    "description": "Allow for the release name to be automatically pre-fixed to each host value when required (default behavior when installing through the parent chart). Alternatively, the host value will be used as is, without any modification.",
                    "default": true
                },
                "auth": {
                    "type": "string",
                    "description": "Auth application default host value, as defined by 'service/serviceAccount:port'",
                    "default": "auth:8080"
                },
                "userPreferences": {
                    "type": "string",
                    "description": "User Preferences host value, If not set a host is generated using service:'user-preferences',port:'8080' and Release namespace & name.",
                    "default": "user-preferences:8080"
                },
                "adminUi": {
                    "type": "string",
                    "description": "Admin UI application default host value, as defined by 'service/serviceAccount:port'",
                    "default": "admin-ui:8080"
                },
                "searchUi": {
                    "type": "string",
                    "description": "Search UI application default host value, as defined by 'service/serviceAccount:port'",
                    "default": "search-ui:8080"
                },
                "graphUi": {
                    "type": "string",
                    "description": "Graph UI application default host value, as defined by 'service/serviceAccount:port'",
                    "default": "graph-ui:8080"
                },
                "queryUi": {
                    "type": "string",
                    "description": "Query UI application default host value, as defined by 'service/serviceAccount:port'",
                    "default": "query-ui:8080"
                },
                "search": {
                    "type": "string",
                    "description": "Search application default host value, as defined by 'service/serviceAccount:port'",
                    "default": "search:8080"
                },
                "graph": {
                    "type": "string",
                    "description": "Graph application default host value, as defined by 'service/serviceAccount:port'",
                    "default": "graph:8080"
                }
            }
        },
        "hostsPreview": {
            "type": "object",
            "properties": {
                "enableAutoCorrect": {
                    "type": "boolean",
                    "description": "Prefix 'global.releaseNameTelicentPreview' to each host value. Alternatively, the host value will be used as is, without any modification.",
                    "default": true
                },
                "dataCatalogUi": {
                    "type": "string",
                    "description": "Data Catalog UI application default host value, as defined by 'service/serviceAccount:port'",
                    "default": "data-catalog-ui:8080"
                },
                "userPortalUi": {
                    "type": "string",
                    "description": "User Portal UI application default host value, as defined by 'service/serviceAccount:port'",
                    "default": "user-portal-ui:8080"
                },
                "paperbackWriter": {
                    "type": "string",
                    "description": "Paperback Writer application host value, as defined by 'service/serviceAccount:port'",
                    "default": "paperback-writer:8080"
                }
            }
        }
    }
}
{
    "title": "Chart Values",
    "type": "object",
    "properties": {
        "global": {
            "type": "object",
            "properties": {
                "imageRegistry": {
                    "type": "string",
                    "description": "Global image registry",
                    "default": ""
                },
                "imagePullSecrets": {
                    "type": "array",
                    "description": "Global registry secret names as an array",
                    "default": [],
                    "items": {}
                },
                "enterprise": {
                    "type": "boolean",
                    "description": "Enable enterprise mode, adding additional features and configurations",
                    "default": false
                },
                "appHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent application/ui services",
                    "default": "apps.telicent.io"
                },
                "apiHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent Api services",
                    "default": "api.telicent.io"
                },
                "authHostDomain": {
                    "type": "string",
                    "description": "Domain associated with Telicent authentication services, including OIDC providers",
                    "default": "auth.telicent.io"
                },
                "groupsClaim": {
                    "type": "string",
                    "description": "Key used to retrieve groups from the OIDC provider",
                    "default": "groups"
                },
                "istioNamespace": {
                    "type": "string",
                    "description": "Namespace in which Istio is deployed",
                    "default": "istio-system"
                },
                "istioServiceAccountName": {
                    "type": "string",
                    "description": "Name of the Istio service account",
                    "default": "istio-ingress"
                },
                "istioGatewayName": {
                    "type": "string",
                    "description": "Name of the Istio Gateway Resource (LB operating at the edge of the mesh)",
                    "default": "ingress-gateway"
                },
                "istioVirtualServiceEnabled": {
                    "type": "boolean",
                    "description": "Enable Istio traffic routing to a named destination service",
                    "default": true
                }
            }
        },
        "forwardAuth": {
            "type": "object",
            "properties": {
                "existingSecret": {
                    "type": "string",
                    "description": "Name of an existing secret. The secret must contain 1 key: 'secret'",
                    "default": ""
                },
                "header": {
                    "type": "string",
                    "description": "The secret value to be associated with the `X-ForwardAuth-Secret`.",
                    "default": ""
                }
            }
        },
        "logs": {
            "type": "object",
            "properties": {
                "general": {
                    "type": "object",
                    "properties": {
                        "level": {
                            "type": "string",
                            "description": "Set logging levels, values are: TRACE, DEBUG, INFO, WARN, ERROR, FATAL, and PANIC.",
                            "default": "DEBUG"
                        }
                    }
                },
                "access": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Enable access logging. Note: should only be enabled in development environments.",
                            "default": false
                        }
                    }
                }
            }
        },
        "dashboard": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Enable *Traefik Proxy* dashboard. Note: should only be enabled in development environments.",
                    "default": false
                },
                "domain": {
                    "type": "string",
                    "description": "Domain associated with *Traefik Proxy* dashboard. If not set, 'appHostDomain' will be used",
                    "default": ""
                },
                "basepath": {
                    "type": "string",
                    "description": "Set the base path to be used for accessing the dashboard",
                    "default": "/traefik"
                }
            }
        },
        "nameOverride": {
            "type": "string",
            "description": "String to partially override fullname (will maintain the release name)",
            "default": ""
        },
        "fullnameOverride": {
            "type": "string",
            "description": "String to fully override the generated release name",
            "default": ""
        },
        "namespaceOverride": {
            "type": "string",
            "description": "String to fully override all deployed resources namespace",
            "default": ""
        },
        "commonLabels": {
            "type": "object",
            "description": "Add labels to all the deployed resources",
            "default": {}
        },
        "replicas": {
            "type": "number",
            "description": "Number of *Traefik Proxy* replicas to deploy",
            "default": 1
        },
        "revisionHistoryLimit": {
            "type": "number",
            "description": "Number of controller revisions to keep",
            "default": 5
        },
        "annotations": {
            "type": "object",
            "description": "Add extra annotations to the deployment object",
            "default": {}
        },
        "podLabels": {
            "type": "object",
            "description": "Add extra labels to the *Traefik Proxy* pod",
            "default": {}
        },
        "podAnnotations": {
            "type": "object",
            "description": "Add extra annotations to the *Traefik Proxy* pod",
            "default": {}
        },
        "extraEnvVars": {
            "type": "array",
            "description": "Array with extra environment variables to add to *Traefik Proxy* pod",
            "default": [],
            "items": {}
        },
        "extraVolumes": {
            "type": "array",
            "description": "Additional containers to be added to the *Traefik Proxy* pod",
            "default": [],
            "items": {}
        },
        "extraVolumeMounts": {
            "type": "array",
            "description": "Optionally specify extra list of additional volumeMounts",
            "default": [],
            "items": {}
        },
        "initContainers": {
            "type": "array",
            "description": "Add init containers to the pod",
            "default": [],
            "items": {}
        },
        "sidecars": {
            "type": "array",
            "description": "Add sidecars to the pod.",
            "default": [],
            "items": {}
        },
        "image": {
            "type": "object",
            "properties": {
                "registry": {
                    "type": "string",
                    "description": "*Traefik Proxy* image registry",
                    "default": "REGISTRY_NAME"
                },
                "repository": {
                    "type": "string",
                    "description": "*Traefik Proxy* image name",
                    "default": "REPOSITORY_NAME/traefik"
                },
                "tag": {
                    "type": "string",
                    "description": "*Traefik Proxy* image tag. If not set, a tag is generated using the appVersion",
                    "default": ""
                },
                "pullPolicy": {
                    "type": "string",
                    "description": "*Traefik Proxy* image pull policy",
                    "default": "IfNotPresent"
                },
                "pullSecrets": {
                    "type": "array",
                    "description": "Specify registry secret names as an array",
                    "default": [],
                    "items": {}
                }
            }
        },
        "resources": {
            "type": "object",
            "properties": {
                "requests": {
                    "type": "object",
                    "properties": {
                        "cpu": {
                            "type": "string",
                            "description": "Set containers' CPU request",
                            "default": "125m"
                        },
                        "memory": {
                            "type": "string",
                            "description": "Set containers' memory request",
                            "default": "512Mi"
                        }
                    }
                },
                "limits": {
                    "type": "object",
                    "properties": {
                        "cpu": {
                            "type": "string",
                            "description": "Set containers' CPU limit",
                            "default": "250m"
                        },
                        "memory": {
                            "type": "string",
                            "description": "Set containers' memory limit",
                            "default": "768Mi"
                        }
                    }
                }
            }
        },
        "containerSecurityContext": {
            "type": "object",
            "properties": {
                "runAsUser": {
                    "type": "number",
                    "description": "Set containers' Security Context runAsUser User ID",
                    "default": 185
                },
                "runAsGroup": {
                    "type": "number",
                    "description": "Set containers' Security Context runAsGroup Group ID",
                    "default": 185
                },
                "runAsNonRoot": {
                    "type": "boolean",
                    "description": "Set container's Security Context runAsNonRoot",
                    "default": true
                },
                "allowPrivilegeEscalation": {
                    "type": "boolean",
                    "description": "Set container's Security Context allowPrivilegeEscalation",
                    "default": false
                },
                "capabilities": {
                    "type": "object",
                    "properties": {
                        "drop": {
                            "type": "array",
                            "description": "List of capabilities to be dropped",
                            "default": [
                                "ALL"
                            ],
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "seccompProfile": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "description": "Set container's Security Context seccomp profile",
                            "default": "RuntimeDefault"
                        }
                    }
                }
            }
        },
        "podSecurityContext": {
            "type": "object",
            "properties": {
                "runAsUser": {
                    "type": "number",
                    "description": "Set the provisioning pod's Security Context runAsUser User ID",
                    "default": 185
                },
                "runAsGroup": {
                    "type": "number",
                    "description": "Set the provisioning pod's Security Context runAsGroup Group ID",
                    "default": 185
                },
                "runAsNonRoot": {
                    "type": "boolean",
                    "description": "Set the provisioning pod's Security Context runAsNonRoot",
                    "default": true
                },
                "fsGroup": {
                    "type": "number",
                    "description": "Set the provisioning pod's Group ID for the mounted volumes' filesystem",
                    "default": 185
                },
                "seccompProfile": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "description": "Set the provisioning pod's Security Context seccomp profile",
                            "default": "RuntimeDefault"
                        }
                    }
                }
            }
        },
        "affinity": {
            "type": "object",
            "description": "Affinity for pod assignment",
            "default": {}
        },
        "nodeSelector": {
            "type": "object",
            "description": "Node labels for pod assignment",
            "default": {}
        },
        "tolerations": {
            "type": "array",
            "description": "Tolerations for pod assignment",
            "default": [],
            "items": {}
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "create": {
                    "type": "boolean",
                    "description": "Specifies whether a service account should be created",
                    "default": true
                },
                "name": {
                    "type": "string",
                    "description": "Name of the ServiceAccount to use. If not set, a name is generated using the fullname",
                    "default": ""
                },
                "annotations": {
                    "type": "object",
                    "description": "Additional custom annotations for the ServiceAccount",
                    "default": {}
                },
                "automount": {
                    "type": "boolean",
                    "description": "Automatically mount a ServiceAccount's API credentials",
                    "default": true
                }
            }
        },
        "service": {
            "type": "object",
            "properties": {
                "app": {
                    "type": "object",
                    "properties": {
                        "port": {
                            "type": "number",
                            "description": "*Traefik Proxy* APP/UI service port",
                            "default": 8080
                        },
                        "type": {
                            "type": "string",
                            "description": "*Traefik Proxy* APP/UI service type",
                            "default": "ClusterIP"
                        }
                    }
                },
                "api": {
                    "type": "object",
                    "properties": {
                        "port": {
                            "type": "number",
                            "description": "*Traefik Proxy* service port",
                            "default": 8081
                        },
                        "type": {
                            "type": "string",
                            "description": "*Traefik Proxy* service type",
                            "default": "ClusterIP"
                        }
                    }
                }
            }
        },
        "istio": {
            "type": "object",
            "properties": {
                "virtualService": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Enable Istio traffic into *Traefik Proxy*",
                            "default": true
                        },
                        "extraHosts": {
                            "type": "array",
                            "description": "Additional hosts (excluding appHostDomain) to be managed by *Traefik Proxy*",
                            "default": [],
                            "items": {}
                        }
                    }
                },
                "ingress": {
                    "type": "object",
                    "properties": {
                        "principal": {
                            "type": "string",
                            "description": "Principal used for ingress traffic by the Istio AuthorizationPolicy. If not set, a principal is generated using Release namespace and serviceAccountName",
                            "default": "cluster.local/ns/istio-system/sa/istio-ingress"
                        },
                        "serviceAccountName": {
                            "type": "string",
                            "description": "Name of the Ingress service account (istio currently supported)",
                            "default": "istio-ingress"
                        }
                    }
                }
            }
        },
        "hosts": {
            "type": "object",
            "properties": {
                "auth": {
                    "type": "string",
                    "description": "Auth host value, If not set a host is generated using service:'auth',port:'8080' and Release namespace & name.",
                    "default": ""
                },
                "access": {
                    "type": "string",
                    "description": "Access host value, If not set a host is generated using service:'access',port:'8080' and Release namespace & name.",
                    "default": ""
                },
                "adminUi": {
                    "type": "string",
                    "description": "Admin UI host value, If not set a host is generated using service:'admin-ui',port:'8080' and Release namespace & name.",
                    "default": ""
                },
                "accessUi": {
                    "type": "string",
                    "description": "Access host value, If not set a host is generated using service:'access-ui',port:'8080' and Release namespace & name.",
                    "default": ""
                },
                "searchUi": {
                    "type": "string",
                    "description": "Access host value, If not set a host is generated using service:'search-ui',port:'8080' and Release namespace & name.",
                    "default": ""
                },
                "graphUi": {
                    "type": "string",
                    "description": "Graph UI host value, If not set a host is generated using service:'graph-ui',port:'8080' and Release namespace & name.",
                    "default": ""
                },
                "queryUi": {
                    "type": "string",
                    "description": "Query UI host value, If not set a host is generated using service:'query-ui',port:'8080' and Release namespace & name.",
                    "default": ""
                },
                "search": {
                    "type": "string",
                    "description": "Search host value, If not set a host is generated using service:'search',port:'8080' and Release namespace & name.",
                    "default": ""
                },
                "graph": {
                    "type": "string",
                    "description": "Graph host value, If not set a host is generated using service:'graph',port:'8080' and Release namespace & name.",
                    "default": ""
                },
                "userPreferences": {
                    "type": "string",
                    "description": "User Preferences host value, If not set a host is generated using service:'user-preferences',port:'8080' and Release namespace & name.",
                    "default": ""
                },
                "oauth2Proxy": {
                    "type": "string",
                    "description": "Oauth2 Proxy host value, If not set a host is generated using service:'oauth2-proxy',port:'4080' and Release namespace & name.",
                    "default": ""
                },
                "whoami": {
                    "type": "string",
                    "description": "Whoami host value, If not set a host is generated using service:'whoami',port:'8080' and Release namespace & name. AB:test purposes, be removed afterwards",
                    "default": ""
                },
                "paperbackWriter": {
                    "type": "string",
                    "description": "If not set a host is generated using service:'paperback-writer', port:'8000' and Release namespace & name.",
                    "default": ""
                }
            }
        }
    }
}